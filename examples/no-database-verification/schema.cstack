// cratestack#329 verification fixture: a genuinely procedures-only,
// `datasource { provider = "none" }` schema. No `model` blocks — the parser
// rejects them under `provider = "none"` (cratestack#327).

datasource db {
  provider = "none"
}

type PingArgs {
  message String
}

type PingReply {
  echo String
}

procedure ping(args: PingArgs): PingReply
  @allow(auth() != null)
