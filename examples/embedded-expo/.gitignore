/native/target
/native/Cargo.lock

# Expo + RN build outputs.
/app/node_modules
/app/.expo
/app/dist
/app/web-build

# NOTE: `/app/pnpm-lock.yaml` used to be listed above, grouped in with the
# build outputs. A lockfile is not a build output — ignoring it made this
# example the only one in the repo that could not be installed
# reproducibly, and (combined with the missing `pnpm-workspace.yaml`, see
# that file) meant `pnpm audit` here silently reported on the *repo root*
# tree instead of this one, so this example's own dependency advisories
# were invisible. The lockfile is now committed like every other example's.

# Generated by `npx expo prebuild` (or first `expo run:*`).
/app/ios
/app/android

# Per-module build outputs inside the local Expo native module.
# `npx create-expo-module --local` generates the source files we DO
# check in; everything below is build output or cargo-ndk artifacts.
/app/modules/cratestack-notes/build
/app/modules/cratestack-notes/android/build
/app/modules/cratestack-notes/android/.gradle
/app/modules/cratestack-notes/android/src/main/jniLibs
/app/modules/cratestack-notes/ios/build
/app/modules/cratestack-notes/node_modules
