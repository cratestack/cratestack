{
  "name": "embedded-browser-vite-example",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "node ../../../examples/scripts/wasm-build.mjs --target web --out-dir web/pkg",
    "wasm:build:dev": "node ../../../examples/scripts/wasm-build.mjs --target web --out-dir web/pkg --dev",
    "dev": "pnpm run wasm:build:dev && vite",
    "build": "pnpm run wasm:build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cratestack/cbor": "link:../../../packages/cratestack-cbor",
    "@cratestack/cbor-web": "link:../../../packages/cratestack-cbor-web"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
