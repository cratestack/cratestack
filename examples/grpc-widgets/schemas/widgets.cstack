// `transport grpc` example schema (ticket #171) — a single `Widget`
// model exposed as a real gRPC service, verifiable with `grpcurl` (no
// REST/RPC surface: `transport grpc` is exclusive with both).

transport grpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Operator {
  id Int
}

model Widget {
  id Int @id
  name String

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
  @@allow("delete", auth() != null)
}

// Ticket #208: a unary procedure and a `List`-arity (server-streaming)
// procedure, both reachable over gRPC — see `src/main.rs`'s
// `ProcedureRegistry` impl and the README's `grpcurl` sessions.
procedure echoWidgetName(name: String): String
  @allow(auth() != null)

procedure widgetNameSamples(): String[]
  @allow(auth() != null)
