# Not committed alongside `client/` itself (unlike react-vite-swr's
# analogous `client/dist/`/`client/node_modules/` pattern, this file
# lives at the example root, not inside `client/`): `cratestack
# generate-dart --check` treats every file under `--out` as either
# generator output or drift, so a `.gitignore` living *inside* `client/`
# would make `--check` permanently report it as "unexpected" even with
# zero real drift. Keeping generator-external ignore rules up here
# avoids that false positive.

# `client/`: not a "generated but checked in" package like
# react-vite-swr/client — this package's `@riverpod` annotations only
# become working code after `dart run build_runner build` runs (issue
# #303), so its `.g.dart` outputs are build artifacts, not generator
# output. Regenerate them (`dart run build_runner build
# --delete-conflicting-outputs`, or `cratestack generate-dart
# --run-build-runner`) rather than committing them — see the top-level
# README's "full path" section. `.mapper.dart` (issue #325's
# `dart_mappable_builder` output, expanded in the same `build_runner`
# pass) is the same kind of artifact for the same reason.
client/**/*.g.dart
client/**/*.mapper.dart
# `part 'models.builder.dart';`/`part '<stem>.builder.dart';` (issue #668
# phase 2) — expanded by `package:cratestack_builder` in the same
# `build_runner` pass as the two patterns above, same "build artifact, not
# generator output" reasoning.
client/**/*.builder.dart
client/.dart_tool/
client/build/
client/pubspec.lock
# Written by `flutter pub get` whenever the dependency graph contains a
# Flutter *plugin* (one with native platform code). New as of
# cratestack#779: this client took `--no-native-cbor` until then, so it
# depended on pure-Dart `package:cbor` and no plugin was ever resolved —
# now it depends on `cratestack_cbor`, which is one, and the file appears.
# Build artifact of resolution, not generator output.
client/.flutter-plugins-dependencies
