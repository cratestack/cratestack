{
  "name": "react-vite-swr-web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter react-vite-swr-client run build",
    "dev": "vite",
    "prebuild": "pnpm --filter react-vite-swr-client run build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-vite-swr-client": "workspace:*",
    "swr": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
