// End-to-end example schema for issue #306 (epic #298's last story): a
// small "task board" — two models with a real relation, plus one
// procedure — rich enough to exercise the `swr` preset's full surface
// (list/get/create/update/delete hooks, invalidation, a query
// procedure) without tripping either of the preset's two known
// pre-existing gaps: no `@@paged` model here (the preset never imports
// `Page`/`PageInfo` for one — see the generator's own follow-up ticket),
// and no two model names that collapse under `to_camel_case` (the
// default preset's `cratestack QueryKeys` collision — irrelevant to
// `swr`'s own key factory, which nests under each model's literal
// route instead, but avoided here anyway since it costs nothing).
//
// `transport rest` (the default — no `transport rpc` line) keeps the
// wire format plain `fetch`/JSON, the simplest shape for a first real
// consumer of the preset to read end to end.

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Caller {
  id Int
}

model Board {
  id Int @id
  name String

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
  @@allow("delete", auth() != null)
}

model Task {
  id Int @id
  title String
  done Boolean
  boardId Int
  board Board @relation(fields:[boardId],references:[id])

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
  @@allow("delete", auth() != null)
}

type FocusEstimateArgs {
  taskCount Int
  minutesPerTask Int
}

type FocusEstimateResult {
  totalMinutes Int
}

// Pure, stateless query procedure (no DB access — same shape as the
// `rpc-procedures` example's `greet`) so the app has a real non-CRUD
// operation to call both as a hook (`useEstimateFocusMinutesQuery`,
// generated by the `swr` preset) and as a plain function from the
// outside-React script (`scripts/seed.mjs`).
procedure estimateFocusMinutes(args: FocusEstimateArgs): FocusEstimateResult
  @allow(auth() != null)
