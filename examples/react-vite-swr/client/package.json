{
  "name": "react-vite-swr-client",
  "version": "0.0.0",
  "description": "Generated CrateStack TypeScript client package (swr preset — file-per-model, framework-free).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models/*": {
      "types": "./dist/models/*.d.ts",
      "import": "./dist/models/*.js"
    },
    "./procedures": {
      "types": "./dist/procedures.d.ts",
      "import": "./dist/procedures.js"
    },
    "./procedures.hooks": {
      "types": "./dist/procedures.hooks.d.ts",
      "import": "./dist/procedures.hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.2.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.2.0",
    "typescript": "^7.0.2"
  }
}