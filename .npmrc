# Link @cratestack/* packages within this workspace to each other via
# symlink instead of pnpm trying to fetch them from the registry — the
# `@cratestack/api` family's package.jsons deliberately pin exact
# version strings (not the `workspace:*` protocol) for their internal
# cross-package deps, so a plain `npm publish` per package (this repo's
# release-cli.yml, no pnpm-specific rewriting step) publishes a normal
# resolvable semver dependency instead of a `workspace:*` string npm's
# registry can't understand.
link-workspace-packages=true
