.dart_tool/
.packages
pubspec.lock
# The example app (cratestack#563) is an application target, not a
# library — commit its lockfile for reproducibility, same convention as
# examples/flutter-riverpod/app/pubspec.lock. This negates the broad
# `pubspec.lock` rule above, which otherwise applies recursively.
!example/pubspec.lock

# Build outputs, vendored into the PUBLISHED archive but never into VCS
# (CLAUDE.md: "Don't commit generated build output"; cratestack#563:
# frb glue is "generated in CI, not committed"). `.pubignore` above keeps
# `dart pub publish` shipping them anyway — see this package's README.
blobs/
lib/src/web/wasm-pkg/
lib/src/native/rust/

# The assembled macOS xcframework (`just cbor-vendor-macos`) — NOT under
# `blobs/`, unlike every other platform's build output, because CocoaPods
# resolves a podspec's `vendored_frameworks` relative to the podspec's own
# directory (see `macos/cratestack_cbor.podspec`'s header comment for why
# `..` escapes out of `macos/` aren't reliable). Still gitignored-but-
# published: `.pubignore` above covers this path too, same as `blobs/`.
macos/Frameworks/
