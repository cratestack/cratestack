{
  "name": "@cratestack/api",
  "version": "0.5.2",
  "description": "Composable links for CrateStack's generated TypeScript RPC client — batching, logging, and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cratestack/cratestack.git",
    "directory": "packages/cratestack-api"
  },
  "homepage": "https://cratestack.dev",
  "bugs": "https://github.com/cratestack/cratestack/issues",
  "keywords": ["cratestack", "cstack", "rpc", "batching", "trpc-links"],
  "type": "module",
  "main": "./dist/index.js",
