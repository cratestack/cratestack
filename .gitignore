/target/
/tmp/
/.env
.env.local
*.log
*.vsix
packages/*/node_modules/
packages/*/.vscode-test/
.idea
.claude

node_modules
.turbo
packages/*/dist/

# napi-rs build output for packages/cratestack-cbor-node (crates/cratestack-cbor-napi)
# — regenerated by `napi build`, never committed. See its package.json's
# "build" script and .github/workflows for how these get produced.
packages/cratestack-cbor-node/native.mjs
packages/cratestack-cbor-node/native.d.mts
packages/cratestack-cbor-node/*.node
packages/cratestack-cbor-node/npm/

# @cratestack/refine's test fixture — a real generated TypeScript client,
# produced by `just refine-fixture` (cargo run -p cratestack-cli --
# generate-typescript against packages/cratestack-refine/tests/fixtures/
# refine_fixture.cstack). Generated build output, never committed
# (cratestack#577); CI's `js (@cratestack/refine)` job regenerates it fresh
# on a Rust-toolchain runner before testing. The test suite fails loudly,
# not silently, if this is missing locally — see
# packages/cratestack-refine/tests/support/assert-fixture-present.ts.
packages/cratestack-refine/tests/fixtures/generated-client/

# Same story, RPC sibling: `just refine-rpc-fixture` against
# tests/fixtures/refine_fixture_rpc.cstack (`transport rpc`), driving
# `createCratestackRpcDataProvider`.
packages/cratestack-refine/tests/fixtures/generated-client-rpc/

*.tar.gz

# Quality pipeline: generated at scan time, never committed (see
# .ci/quality/README.md). .gitkeep keeps the directory tracked.
.ci/quality/reports/*
!.ci/quality/reports/.gitkeep
__pycache__/
*.pyc
# Dart/Flutter tool cache. Regenerated by `pub get`/`flutter pub get`,
# never committed. Eight per-directory .gitignore files already cover the
# Dart packages and examples that exist today; this root rule is the
# backstop for directories that have no .gitignore of their own — a stale
# `examples/grpc-widgets/dart-client/.dart_tool/` (from the gRPC removal,
# ADR 0017) was swept into a commit by `git add -A` precisely because
# nothing ignored it there.
.dart_tool/
