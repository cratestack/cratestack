// `contract_roundtrip_default_old.cstack` after the refused edit: `Paint`
// gains `level Int @default(1)`.

transport rpc

datasource db {
  provider = "none"
}

type Paint {
  size Int
  level Int @default(1)
}

type Reply {
  ok Boolean
}

procedure paint(args: Paint): Reply
  @allow(auth() != null)
