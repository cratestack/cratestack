// Review of cratestack#1132 (B1): the old half of the one edit the
// classifier must REFUSE although it looks additive. `Paint` is an input-only
// `type`; the new schema adds a required field carrying `@default`, which
// only a model op's create input honours. `contract_roundtrip.rs` pins that
// the classifier says Breaking and that the generated decode really fails.

transport rpc

datasource db {
  provider = "none"
}

type Paint {
  size Int
}

type Reply {
  ok Boolean
}

procedure paint(args: Paint): Reply
  @allow(auth() != null)
