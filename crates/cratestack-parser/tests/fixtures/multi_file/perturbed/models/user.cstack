part of "../schema.cstack"

/// Where a post is in its life.
enum PostStatus {
  Draft
  Published
}

/// A post, written by a user.
model Post {
  @use(Timestamps)
  @use(Audited)
  id Int @id
  authorId Int
  author User @relation(fields:[authorId],references:[id])
  status PostStatus
  title String

  @@allow("read", true)
}
