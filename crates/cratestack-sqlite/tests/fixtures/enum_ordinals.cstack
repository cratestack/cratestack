// Ordinal enums (`Pending = 1`, docs/design/enum-ordinals.md) on the
// embedded backend: stored as integers, decoded back into variants,
// filtered by variant, and sent over JSON as the number. No `@default`:
// the embedded DDL declares no column defaults, for any field type.

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

enum PaymentStatus {
  Pending = 1
  Approved = 2
  Refunded = 5

  @@reserved(3, 4)
}

model Payment {
  id Int @id
  status PaymentStatus
  previous PaymentStatus?
}
