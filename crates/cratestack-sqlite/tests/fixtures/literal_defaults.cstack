// cratestack#1234: literal `@default`s on the embedded runtime. They used
// to be written as NULL, since the embedded tables carried no DEFAULT
// clauses and the runtime bound nothing; the create then failed decoding
// the row.

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

enum Status {
  Draft
  Live
}

enum Priority {
  Low = 1
  High = 2
}

model Item {
  id       String   @id
  done     Boolean  @default(false)
  count    Int      @default(-3)
  big      BigInt   @default(9007199254740993)
  ratio    Float    @default(1.5)
  price    Decimal  @default(12.50)
  label    String   @default("it's \"x\"")
  status   Status   @default(Live)
  priority Priority @default(High)
  ref      Uuid     @default("6f1c2d4e-8b3a-4c5d-9e7f-0a1b2c3d4e5f")
  since    DateTime @default("2026-01-02T03:04:05Z")
  note     String?  @default("n/a")
  title    String
}
