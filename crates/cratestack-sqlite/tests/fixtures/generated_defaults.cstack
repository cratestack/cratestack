// cratestack#1209: `@default(uuid())`, `cuid()` and `now()` are generated by
// the runtime on create. The embedded tables carry no `DEFAULT` clauses, so
// before this the columns were written as NULL and the row failed to decode.

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Ticket {
  id        Uuid     @id @default(uuid())
  code      Cuid     @default(cuid())
  reference String   @default(uuid())
  createdAt DateTime @default(now())
  title     String
}
