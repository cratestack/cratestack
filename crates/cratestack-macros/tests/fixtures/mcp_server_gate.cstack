// cratestack#1036 (ADR 0002 Q4): a valid MCP schema — block, a tool with a
// defaulted name, a named tool with a description, and a resource with a
// lowered page size. Built without the `mcp` feature (as this crate's tests
// are), `include_server_schema!` must refuse it asking for the feature; with
// the feature, the resource still keeps it from compiling until phase 5
// (cratestack#1033). Also the tree-sitter-cstack conformance fixture for the
// syntax.

datasource db {
  provider = "postgresql"
}

mcp {
  expose = [tools, resources]
}

type FeedArgs {
  limit Int
}

model Post {
  id        Int     @id
  title     String
  published Boolean

  @@allow("read", published)
  @@mcp(resource: "posts", max_page_size: 50)
}

procedure getFeed(args: FeedArgs): Post[]
  @allow(auth() != null)
  @mcp(tool)

mutation procedure publishPost(args: FeedArgs): Post
  @allow(auth() != null)
  @mcp(tool: "publish_post", description: "Publish a draft post, then notify.")
