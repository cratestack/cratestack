// cratestack#1036 (ADR 0002 Q4): the tools-only shape a `db = None`
// (`cratestack-api`) service would use. Since cratestack#1038 it compiles
// when `cratestack-macros` has its `mcp` feature; this crate's own tests
// build without it, so here it must fail asking for the feature.

datasource db {
  provider = "none"
}

mcp {
  expose = [tools]
}

type PingArgs {
  message String
}

type PingReply {
  echo String
}

procedure ping(args: PingArgs): PingReply
  @allow(auth() != null)
  @mcp(tool: "ping")
