import 'package:flutter_riverpod/flutter_riverpod.dart';

{% if model_apis | length > 0 or procedures | length > 0 or subscription_procedures | length > 0 %}
{# cratestack#785, RPC's half of the same gate the REST template carries
   (transport parity): `models.dart` is reached only from the per-model
   API classes and from each procedure's generated args wrapper. There is
   no `queries.dart` on this transport, so this is the only import here
   that can go dead. #}
import 'models.dart';
{% endif %}
import 'runtime.dart';

class {{ client_class_name }} {
  {{ client_class_name }}(this._adapter{% if has_subscriptions %}, {this.subscriptions = const CratestackSubscriptionOptions()}{% endif %});

  final CratestackRpcAdapter _adapter;
{% if has_subscriptions %}

  /// How this client subscribes: the binding, the WebTransport listener, the
  /// socket credentials.
  final CratestackSubscriptionOptions subscriptions;
{% endif %}

  CratestackRpcAdapter get adapter => _adapter;

{% for accessor in model_accessors %}
  {{ accessor.api_class_name }} get {{ accessor.accessor }} => {{ accessor.api_class_name }}(this);
{% endfor %}
{% if procedures | length > 0 or subscription_procedures | length > 0 %}
  ProceduresApi get procedures => ProceduresApi(this);
{% else %}
  ProceduresApi get procedures => const ProceduresApi();
{% endif %}
{% if has_subscriptions %}

  /// Opens a subscription over the binding [subscriptions] chooses (slice
  /// S6): nothing is emitted until the server says `Ready`. It needs the
  /// generated HTTP adapter, for the base URI and SSE.
  Stream<Object?> subscribe(
    CratestackSubscriptionTarget target, {
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    final adapter = _adapter;
    if (adapter is! CratestackRpcHttpAdapter) {
      return Stream<Object?>.error(UnsupportedError(
        'Subscriptions need a CratestackRpcHttpAdapter; ${adapter.runtimeType} cannot stream.',
      ));
    }
    return cratestackSubscribe(
      options: subscriptions,
      transport: adapter.transport,
      baseUri: adapter.baseUri,
      basePath: '',
      target: target,
      headers: headers,
      onReady: onReady,
    );
  }
{% endif %}
}

final {{ provider_prefix }}AdapterProvider = Provider<CratestackRpcAdapter>((ref) {
  throw UnimplementedError('Override {{ provider_prefix }}AdapterProvider before reading the generated CrateStack client.');
});

{% if has_subscriptions %}
/// How the client subscribes (slice S6). Override it to set the
/// WebTransport listener, the socket credentials or a fixed binding.
final {{ provider_prefix }}SubscriptionOptionsProvider = Provider<CratestackSubscriptionOptions>(
  (ref) => const CratestackSubscriptionOptions(),
);

{% endif %}
final {{ provider_prefix }}ClientProvider = Provider<{{ client_class_name }}>((ref) {
{% if has_subscriptions %}
  return {{ client_class_name }}(
    ref.watch({{ provider_prefix }}AdapterProvider),
    subscriptions: ref.watch({{ provider_prefix }}SubscriptionOptionsProvider),
  );
{% else %}
  return {{ client_class_name }}(ref.watch({{ provider_prefix }}AdapterProvider));
{% endif %}
});

{% for accessor in model_accessors %}
final {{ accessor.provider_name }} = Provider<{{ accessor.api_class_name }}>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).{{ accessor.accessor }};
});

{% endfor %}
final {{ provider_prefix }}ProceduresApiProvider = Provider<ProceduresApi>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).procedures;
});

{% for model in model_apis %}
class {{ model.api_class_name }} {
  const {{ model.api_class_name }}(this._client);

  final {{ client_class_name }} _client;

{% if model.allows_list %}
  Future<{{ model.list_return_type }}> list({
    Map<String, Object?> input = const <String, Object?>{},
{% if model.has_parameterized_computed_fields %}
    /// Typed params for `@computed(params: <Type>?)` resolver fields
    /// (`docs/design/computed-fields.md`), one optional field per
    /// parameterized computed field on `{{ model.model_name }}` (see
    /// `{{ model.computed_params_class_name }}`). Folded into the RPC
    /// input frame's `computedParams` key as JSON text. Only offered
    /// here because this model has at least one parameterized computed
    /// field; the server 422s a `computedParams` key naming a field with
    /// no params type.
    {{ model.computed_params_class_name }}? computedParams,
{% endif %}
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      '{{ model.op_ids.list }}',
{% if model.has_parameterized_computed_fields %}
      cratestackWithRpcComputedParams(input, computedParams?.toWire()),
{% else %}
      input,
{% endif %}
      options: options,
    );
    return {{ model.list_decode_expr }};
  }
{% endif %}

{% if model.allows_get %}
  Future<{{ model.model_name }}> get({{ model.primary_key_type }} id, {
{% if model.has_parameterized_computed_fields %}
    /// Typed params for `@computed(params: <Type>?)` resolver fields
    /// (`docs/design/computed-fields.md`), one optional field per
    /// parameterized computed field on `{{ model.model_name }}` (see
    /// `{{ model.computed_params_class_name }}`). Folded into the RPC
    /// input frame's `computedParams` key as JSON text. Only offered
    /// here because this model has at least one parameterized computed
    /// field; the server 422s a `computedParams` key naming a field with
    /// no params type.
    {{ model.computed_params_class_name }}? computedParams,
{% endif %}
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      '{{ model.op_ids.get }}',
{% if model.has_parameterized_computed_fields %}
      cratestackWithRpcComputedParams({'id': {{ model.primary_key_wire_expr }}}, computedParams?.toWire()),
{% else %}
      {'id': {{ model.primary_key_wire_expr }}},
{% endif %}
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}

{% if model.allows_create %}
  Future<{{ model.model_name }}> create({{ model.create_input_name }} input, {
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      '{{ model.op_ids.create }}',
      input.toWire(),
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}

{% if model.allows_update %}
  Future<{{ model.model_name }}> update({{ model.primary_key_type }} id, {{ model.update_input_name }} patch, {
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      '{{ model.op_ids.update }}',
      {'id': {{ model.primary_key_wire_expr }}, 'patch': patch.toWire()},
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}

{% if model.allows_delete %}
  Future<{{ model.model_name }}> delete({{ model.primary_key_type }} id, {
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      '{{ model.op_ids.delete }}',
      {'id': {{ model.primary_key_wire_expr }}},
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}
{% if model.allows_subscribe %}

  /// Live events of `{{ model.model_name }}` the caller may read, narrowed by
  /// [input]. Nothing is emitted until the subscription is live ([onReady]
  /// fires then); an `unavailable` error means resubscribe and refetch.
  Stream<CratestackModelEvent<{{ model.model_name }}>> subscribe({
    CratestackSubscribeInput input = const CratestackSubscribeInput(),
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    return _client
        .subscribe(
          CratestackSubscriptionTarget(
            opId: '{{ model.subscribe_op_id }}',
            input: input.toWire(),
            ssePath: '/rpc/subscribe/{{ model.subscribe_op_id }}',
            sseQuery: input.toQuery(),
            socketPath: '/rpc/ws',
          ),
          headers: headers,
          onReady: onReady,
        )
        .map((wire) => CratestackModelEvent<{{ model.model_name }}>.fromWire(
              wire,
              (data) => {{ model.model_name }}.fromWire(cratestackAsValueMap(data)),
            ));
  }
{% endif %}
}

{% endfor %}
{% if procedures | length > 0 or subscription_procedures | length > 0 %}
class ProceduresApi {
  const ProceduresApi(this._client);

  final {{ client_class_name }} _client;

{% for procedure in procedures %}
  Future<{{ procedure.return_type }}> {{ procedure.method_name }}({{ procedure.args_name }} args, {
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      '{{ procedure.op_id }}',
      args.toWire(),
      options: options,
    );
    return {{ procedure.return_decode_expr }};
  }

{% endfor %}
{% for procedure in subscription_procedures %}
  /// Subscribes to `{{ procedure.name }}`. A policy or setup refusal is the
  /// stream's error before any item.
  Stream<{{ procedure.return_type }}> {{ procedure.method_name }}({{ procedure.args_name }} args, {
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    return _client
        .subscribe(
          CratestackSubscriptionTarget(
            opId: '{{ procedure.op_id }}',
            input: args.toWire(),
            ssePath: '/rpc/subscribe/{{ procedure.op_id }}',
            sseQuery: cratestackProcedureQuery(args.toWire()),
            socketPath: '/rpc/ws',
          ),
          headers: headers,
          onReady: onReady,
        )
        .map((body) => {{ procedure.return_decode_expr }});
  }

{% endfor %}
}
{% else %}
// cratestack#627: see `rest-apis.dart.j2`'s identical guard for why.
class ProceduresApi {
  const ProceduresApi();
}
{% endif %}
