import 'package:flutter_riverpod/flutter_riverpod.dart';

{% if model_apis | length > 0 or procedures | length > 0 or subscription_procedures | length > 0 %}
{# cratestack#785: `models.dart` is reached from the per-model API classes
   (`{{ model.model_name }}`, `Page<T>`) and from each procedure's
   generated `{{ procedure.args_name }}` wrapper — and from nowhere else,
   so a schema with neither leaves it unsatisfied. #}
import 'models.dart';
{% endif %}
{% if model_apis | length > 0 %}
{# cratestack#785: every `queries.dart` symbol this file names
   (`CratestackListQuery`/`CratestackFetchQuery`/`CratestackProjection`)
   appears only inside the `model_apis` list/fetch query-builder loop
   below, so a procedure-only schema emits a dead import. `flutter
   analyze` reports `unused_import`, and `--fatal-warnings` — Dart's own
   default, and what `just verify-dart` runs — turns that warning into a
   failed build. #}
import 'queries.dart';
{% endif %}
import 'runtime.dart';

class {{ client_class_name }} {
  {{ client_class_name }}(this._adapter, {this.basePath = '{{ base_path_literal }}'});

  final CratestackClientAdapter _adapter;
  final String basePath;

  Future<Object?> execute(
    String method,
    String path, {
    Object? body,
    Map<String, Object?>? queryParameters,
    CratestackCallOptions? options,
  }) {
    return _adapter.execute(
      CratestackRequest(
        method: method,
        path: '$basePath$path',
        queryParameters: queryParameters,
        body: body,
      ),
      options: options,
    );
  }

{% for accessor in model_accessors %}
  {{ accessor.api_class_name }} get {{ accessor.accessor }} => {{ accessor.api_class_name }}(this);
{% endfor %}
{% if procedures | length > 0 or subscription_procedures | length > 0 %}
  ProceduresApi get procedures => ProceduresApi(this);
{% else %}
  ProceduresApi get procedures => const ProceduresApi();
{% endif %}
{% if has_subscriptions %}

  /// Opens a subscription over SSE (slice S6), through the HTTP adapter's
  /// transport: nothing is emitted until the server says `Ready`.
  Stream<Object?> subscribe(
    String path,
    String? query, {
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    final adapter = _adapter;
    if (adapter is! CratestackHttpAdapter) {
      return Stream<Object?>.error(UnsupportedError(
        'Subscriptions need a CratestackHttpAdapter; ${adapter.runtimeType} cannot stream.',
      ));
    }
    return cratestackSubscribeSse(
      adapter.transport,
      adapter.baseUri,
      '$basePath$path',
      query,
      headers: headers,
      onReady: onReady,
    );
  }
{% endif %}
}

final {{ provider_prefix }}AdapterProvider = Provider<CratestackClientAdapter>((ref) {
  throw UnimplementedError('Override {{ provider_prefix }}AdapterProvider before reading the generated CrateStack client.');
});

final {{ provider_prefix }}BasePathProvider = Provider<String>((ref) => '{{ base_path_literal }}');

final {{ provider_prefix }}ClientProvider = Provider<{{ client_class_name }}>((ref) {
  return {{ client_class_name }}(
    ref.watch({{ provider_prefix }}AdapterProvider),
    basePath: ref.watch({{ provider_prefix }}BasePathProvider),
  );
});

{% for accessor in model_accessors %}
final {{ accessor.provider_name }} = Provider<{{ accessor.api_class_name }}>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).{{ accessor.accessor }};
});

{% endfor %}
final {{ provider_prefix }}ProceduresApiProvider = Provider<ProceduresApi>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).procedures;
});

{% for model in model_apis %}
class {{ model.api_class_name }} {
  const {{ model.api_class_name }}(this._client);

  final {{ client_class_name }} _client;

{% if model.allows_list %}
  Future<{{ model.list_return_type }}> list({
    CratestackListQuery? query,
{% if model.has_parameterized_computed_fields %}
    /// Typed params for `@computed(params: <Type>?)` resolver fields
    /// (`docs/design/computed-fields.md`), one optional field per
    /// parameterized computed field on `{{ model.model_name }}` (see
    /// `{{ model.computed_params_class_name }}`). Serialized as a single
    /// JSON-encoded `computedParams` query parameter. Only offered here
    /// because this model has at least one parameterized computed field;
    /// the server 422s a `computedParams` key naming a field with no
    /// params type.
    {{ model.computed_params_class_name }}? computedParams,
{% endif %}
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model.route }}',
{% if model.has_parameterized_computed_fields %}
      queryParameters: cratestackWithComputedParams(query?.toQueryParameters(), computedParams?.toWire()),
{% else %}
      queryParameters: query?.toQueryParameters(),
{% endif %}
      options: options,
    );
    return {{ model.list_decode_expr }};
  }

  Future<{% if model.is_paged %}Page<T>{% else %}List<T>{% endif %}> listView<T>({
    required CratestackProjection<T> projection,
    CratestackListQuery? query,
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model.route }}',
      queryParameters: cratestackMergeFetchIntoListQuery(query, projection.toFetchQuery()).toQueryParameters(),
      options: options,
    );
{% if model.is_paged %}
    return Page<T>.fromWire(
      cratestackAsValueMap(body),
      decodeItem: (item) => projection.fromWire(cratestackAsValueMap(item)),
    );
{% else %}
    return cratestackAsValueList(body)
        .map((item) => projection.fromWire(cratestackAsValueMap(item)))
        .toList(growable: false);
{% endif %}
  }
{% endif %}

{% if model.allows_get %}
  Future<{{ model.model_name }}> get({{ model.primary_key_type }} id, {
    CratestackFetchQuery? query,
{% if model.has_parameterized_computed_fields %}
    /// Typed params for `@computed(params: <Type>?)` resolver fields
    /// (`docs/design/computed-fields.md`), one optional field per
    /// parameterized computed field on `{{ model.model_name }}` (see
    /// `{{ model.computed_params_class_name }}`). Serialized as a single
    /// JSON-encoded `computedParams` query parameter. Only offered here
    /// because this model has at least one parameterized computed field;
    /// the server 422s a `computedParams` key naming a field with no
    /// params type.
    {{ model.computed_params_class_name }}? computedParams,
{% endif %}
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model.detail_route }}',
{% if model.has_parameterized_computed_fields %}
      queryParameters: cratestackWithComputedParams(query?.toQueryParameters(), computedParams?.toWire()),
{% else %}
      queryParameters: query?.toQueryParameters(),
{% endif %}
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }

  Future<T> getView<T>({{ model.primary_key_type }} id, {
    required CratestackProjection<T> projection,
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model.detail_route }}',
      queryParameters: projection.toFetchQuery().toQueryParameters(),
      options: options,
    );
    return projection.fromWire(cratestackAsValueMap(body));
  }
{% endif %}

{% if model.allows_create %}
  Future<{{ model.model_name }}> create({{ model.create_input_name }} input, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'POST',
      '{{ model.route }}',
      body: input.toWire(),
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}

{% if model.allows_update %}
  Future<{{ model.model_name }}> update({{ model.primary_key_type }} id, {{ model.update_input_name }} input, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'PATCH',
      '{{ model.detail_route }}',
      body: input.toWire(),
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}

{% if model.allows_delete %}
  Future<{{ model.model_name }}> delete({{ model.primary_key_type }} id, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'DELETE',
      '{{ model.detail_route }}',
      options: options,
    );
    return {{ model.model_name }}.fromWire(cratestackAsValueMap(body));
  }
{% endif %}
{% if model.allows_subscribe %}

  /// Live events of `{{ model.model_name }}` the caller may read, narrowed by
  /// [input]. Nothing is emitted until the subscription is live ([onReady]
  /// fires then); an `unavailable` error means resubscribe and refetch.
  Stream<CratestackModelEvent<{{ model.model_name }}>> subscribe({
    CratestackSubscribeInput input = const CratestackSubscribeInput(),
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    return _client
        .subscribe('{{ model.subscribe_route }}', input.toQuery(), headers: headers, onReady: onReady)
        .map((wire) => CratestackModelEvent<{{ model.model_name }}>.fromWire(
              wire,
              (data) => {{ model.model_name }}.fromWire(cratestackAsValueMap(data)),
            ));
  }
{% endif %}
}

{% endfor %}
{% if procedures | length > 0 or subscription_procedures | length > 0 %}
class ProceduresApi {
  const ProceduresApi(this._client);

  final {{ client_class_name }} _client;

{% for procedure in procedures %}
  Future<{{ procedure.return_type }}> {{ procedure.method_name }}({{ procedure.args_name }} args, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'POST',
      '{{ procedure.route }}',
      body: args.toWire(),
      options: options,
    );
    return {{ procedure.return_decode_expr }};
  }

{% endfor %}
{% for procedure in subscription_procedures %}
  /// Subscribes to `{{ procedure.name }}`. A policy or setup refusal is the
  /// stream's error before any item.
  Stream<{{ procedure.return_type }}> {{ procedure.method_name }}({{ procedure.args_name }} args, {
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    return _client
        .subscribe('{{ procedure.route }}', cratestackProcedureQuery(args.toWire()), headers: headers, onReady: onReady)
        .map((body) => {{ procedure.return_decode_expr }});
  }

{% endfor %}
}
{% else %}
// cratestack#627: a schema with zero procedures still gets a `ProceduresApi`
// but with no `_client` field — nothing would ever read it, and an unread
// private field is a real `unused_field` `flutter analyze
// --fatal-warnings` failure.
class ProceduresApi {
  const ProceduresApi();
}
{% endif %}
