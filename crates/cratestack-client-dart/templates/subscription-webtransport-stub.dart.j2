import 'subscription_sockets.dart';

bool get cratestackWebTransportSupported => false;

Future<Stream<Object?>> cratestackOpenWebTransport(
  Uri url,
  List<List<int>> serverCertificateHashes,
  Map<String, String> headers,
  String opId,
  Object? input,
  Duration? within,
) {
  throw const CratestackSocketUnreachable('WebTransport needs a browser');
}
