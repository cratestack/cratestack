name: {{ package_name }}
description: Generated CrateStack Flutter client package.
publish_to: 'none'
version: 0.1.0

environment:
  # `^3.5.0`, matching every other declared SDK floor in this repo
  # (`dart-packages/cratestack_annotations`, the riverpod preset's own
  # `riverpod/pubspec.yaml.j2`, `examples/flutter-riverpod/app`). Was
  # `'>=3.0.0 <4.0.0'` — identical upper bound written the long way, with
  # a floor two years below anything the generated code is exercised
  # against.
  sdk: ^3.5.0

dependencies:
  flutter:
    sdk: flutter
  flutter_riverpod: ^3.3.1
{% if native_cbor %}
  # cratestack#563: flutter_rust_bridge/wasm-bindgen codec, vendored
  # prebuilt binaries for Linux x86_64, Windows x64, macOS (universal), iOS
  # (device + simulator), Android (3 ABIs) and web — the default since the
  # native-cbor follow-up landed. Linux arm64 is the only target still
  # unsupported (regenerate with `--no-native-cbor` for that target) — see
  # dart-packages/cratestack_cbor/lib/src/native/native_cbor_codec.dart's
  # `Abi.current()` checks. That gap is blocked upstream, and cratestack#823
  # measured that plain `dart test`/`dart run` is not a way around it — this
  # package needs the Flutter SDK to resolve at all. An
  # API-compatibility FLOOR, not this generator's own
  # crate version: cratestack#779 stopped it moving with `just bump` (which
  # still rewrites dart-packages/*/pubspec.yaml itself) — the value is
  # crates/cratestack-client-dart/src/package_floors.rs's
  # `CRATESTACK_CBOR_FLOOR`.
{# Every floor this template emits is QUOTED. A floor may be a range
    (`CRATESTACK_ANNOTATIONS_FLOOR` is one today), and unquoted YAML reads
    a leading `>` as the folded-block-scalar indicator — `>=` is not a
    valid header, so a bare range is a hard ScannerError at the consumer's
    `pub get` rather than a value that parses wrongly. Quoting a caret is
    a no-op, so all three are quoted rather than only the one that needs
    it today: the next floor to become a range must not rediscover this.
    Deliberately a non-rendering template comment rather than a YAML one:
    this is our concern, not something to ship into every user's pubspec.
    Do not write a closing comment marker in this text — minijinja ends
    the comment at the first one and renders the remainder as YAML. #}
  cratestack_cbor: '{{ cratestack_cbor_version_requirement }}'
{% else %}
  cbor: ^6.5.1
{% endif %}
  dio: ^5.8.0+1
  # cratestack#498: backs every `Decimal`-typed field with a real
  # arbitrary-precision value (`models.dart.j2`'s `DecimalFilter`/
  # per-model data classes) instead of an opaque `String` whose format
  # depends on the server's `decimal-rust-decimal` vs `decimal-bigdecimal`
  # backend choice (#495/#496).
  decimal: ^3.2.6
  # issue #668 phase 2: the runtime-only `@CratestackBuilder` annotation
  # every generated data class in `models.dart` carries. Deliberately a
  # separate package from `cratestack_builder` below (a `dev_dependency`)
  # — see `dart-packages/cratestack_annotations/pubspec.yaml`'s own header
  # comment for why merging them would leak `analyzer`/`build`/`source_gen`
  # into this package's runtime dependency graph.
{# The floor that is actually a range, hence the quotes — see the note
    at the codec dependency above. Keeping this non-rendering matters
    twice over here: that note sits inside the `native_cbor` branch, so a
    rendered YAML comment naming that package would leak the string into
    `--no-native-cbor` output that
    `no_native_cbor_falls_back_to_package_cbor` asserts is free of it. #}
  cratestack_annotations: '{{ cratestack_annotations_version_requirement }}'

dev_dependencies:
  flutter_lints: ^6.0.0
  flutter_test:
    sdk: flutter
  # issue #668 phase 2: expands `models.dart`'s `part 'models.builder.dart';`
  # into the `{Class}Builder` classes this package used to generate inline
  # — see `dart-packages/cratestack_builder`'s own README for what it does.
  build_runner: ^2.15.0
  cratestack_builder: '{{ cratestack_builder_version_requirement }}'
