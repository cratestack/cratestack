name: {{ package_name }}
description: Generated CrateStack Flutter client package.
publish_to: 'none'
version: 0.1.0

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_riverpod: ^3.3.1
{% if native_cbor %}
  # cratestack#563 --native-cbor: flutter_rust_bridge/wasm-bindgen codec,
  # vendored prebuilt binaries for Linux x86_64, Windows x64, macOS
  # (universal), iOS (device + simulator), Android (3 ABIs) and web. Linux
  # arm64 is the only target still unsupported — see
  # dart-packages/cratestack_cbor/lib/src/native/native_cbor_codec.dart's
  # `Abi.current()` checks. Version-locked to this generator's own crate
  # version, the same lockstep convention `just bump` already applies to
  # dart-packages/*/pubspec.yaml.
  cratestack_cbor: {{ cratestack_cbor_version_requirement }}
{% else %}
  cbor: ^6.5.1
{% endif %}
  dio: ^5.8.0+1
  # cratestack#498: backs every `Decimal`-typed field with a real
  # arbitrary-precision value (`models.dart.j2`'s `DecimalFilter`/
  # per-model data classes) instead of an opaque `String` whose format
  # depends on the server's `decimal-rust-decimal` vs `decimal-bigdecimal`
  # backend choice (#495/#496).
  decimal: ^3.2.6

dev_dependencies:
  flutter_lints: ^6.0.0
  flutter_test:
    sdk: flutter
