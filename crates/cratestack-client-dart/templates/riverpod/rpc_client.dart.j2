{% for import in imports %}
{{ import }}
{% endfor %}

class {{ client_class_name }} {
  {{ client_class_name }}(this._adapter{% if has_subscriptions %}, {this.subscriptions = const CratestackSubscriptionOptions()}{% endif %});

  final CratestackRpcAdapter _adapter;
{% if has_subscriptions %}

  /// How this client subscribes: the binding, the WebTransport listener, the
  /// socket credentials.
  final CratestackSubscriptionOptions subscriptions;
{% endif %}

  CratestackRpcAdapter get adapter => _adapter;

{% for accessor in model_accessors %}
  {{ accessor.api_class_name }} get {{ accessor.accessor }} => {{ accessor.api_class_name }}(this);
{% endfor %}
{% if has_procedures %}
  ProceduresApi get procedures => ProceduresApi(this);
{% else %}
  ProceduresApi get procedures => const ProceduresApi();
{% endif %}
{% if has_subscriptions %}

  /// Opens a subscription over the binding [subscriptions] chooses (slice
  /// S6): nothing is emitted until the server says `Ready`. It needs the
  /// generated HTTP adapter, for the base URI and SSE.
  Stream<Object?> subscribe(
    CratestackSubscriptionTarget target, {
    Map<String, String>? headers,
    void Function()? onReady,
  }) {
    final adapter = _adapter;
    if (adapter is! CratestackRpcHttpAdapter) {
      return Stream<Object?>.error(UnsupportedError(
        'Subscriptions need a CratestackRpcHttpAdapter; ${adapter.runtimeType} cannot stream.',
      ));
    }
    return cratestackSubscribe(
      options: subscriptions,
      transport: adapter.transport,
      baseUri: adapter.baseUri,
      basePath: '',
      target: target,
      headers: headers,
      onReady: onReady,
    );
  }
{% endif %}
}

{% if is_fespalier %}
/// The transport every generated call sends through: your `fespalier_transport`
/// chain. No default; the app provides it once.
///
/// ```dart
/// ProviderScope(
///   overrides: [
///     {{ provider_prefix }}TransportProvider.overrideWith(
///       (ref) => SessionTransport(
///         WriteGuardTransport(HttpClientTransport(client)),
///         ref.watch(credentialsProvider),
///       ),
///     ),
///     {{ provider_prefix }}BaseUriProvider.overrideWithValue(
///       Uri.parse('https://api.example.com'),
///     ),
///   ],
///   child: const MyApp(),
/// )
/// ```
final {{ provider_prefix }}TransportProvider = Provider<HttpTransport>((ref) {
  throw UnimplementedError('Override {{ provider_prefix }}TransportProvider with your fespalier_transport chain before reading the generated CrateStack client.');
});

/// The server's origin, with an optional path prefix, that request paths are
/// joined onto: `https://api.example.com` or `https://example.com/v1`. No
/// default.
final {{ provider_prefix }}BaseUriProvider = Provider<Uri>((ref) {
  throw UnimplementedError('Override {{ provider_prefix }}BaseUriProvider with the server\'s origin before reading the generated CrateStack client.');
});

/// The adapter every generated API sends through: the HTTP adapter over
/// [{{ provider_prefix }}TransportProvider]. Override it only to change the wire
/// format or to use another adapter.
final {{ provider_prefix }}AdapterProvider = Provider<CratestackRpcAdapter>((ref) {
  return CratestackRpcHttpAdapter(
    CratestackFespalierTransport(ref.watch({{ provider_prefix }}TransportProvider)),
    baseUri: ref.watch({{ provider_prefix }}BaseUriProvider),
  );
});
{% else %}
/// The adapter every generated API sends through. No default: the app picks
/// its HTTP stack by overriding this provider.
///
/// ```dart
/// ProviderScope(
///   overrides: [
///     {{ provider_prefix }}AdapterProvider.overrideWithValue(
///       CratestackRpcHttpAdapter(
///         CratestackDioTransport(dio),
///         baseUri: Uri.parse('https://api.example.com'),
///       ),
///     ),
///   ],
///   child: const MyApp(),
/// )
/// ```
///
/// `CratestackDioTransport` wraps a `Dio`; any other HTTP stack implements
/// `CratestackHttpTransport` instead.
final {{ provider_prefix }}AdapterProvider = Provider<CratestackRpcAdapter>((ref) {
  throw UnimplementedError('Override {{ provider_prefix }}AdapterProvider before reading the generated CrateStack client.');
});
{% endif %}

{% if has_subscriptions %}
/// How the client subscribes (slice S6). Override it to set the
/// WebTransport listener, the socket credentials or a fixed binding.
final {{ provider_prefix }}SubscriptionOptionsProvider = Provider<CratestackSubscriptionOptions>(
  (ref) => const CratestackSubscriptionOptions(),
);

{% endif %}
final {{ provider_prefix }}ClientProvider = Provider<{{ client_class_name }}>((ref) {
{% if has_subscriptions %}
  return {{ client_class_name }}(
    ref.watch({{ provider_prefix }}AdapterProvider),
    subscriptions: ref.watch({{ provider_prefix }}SubscriptionOptionsProvider),
  );
{% else %}
  return {{ client_class_name }}(ref.watch({{ provider_prefix }}AdapterProvider));
{% endif %}
});
