{% for import in imports %}
{{ import }}
{% endfor %}

part '{{ part_file_name }}';
{% if data_classes | length > 0 %}
// issue #325: gated (unlike `part_file_name` above) — see
// `rest_procedures.dart.j2`'s identical guard for why.
part '{{ mapper_part_file_name }}';
{% endif %}

{% include "riverpod/enums_and_data_classes.dart.j2" %}
{% if procedures | length > 0 %}
class ProceduresApi {
  const ProceduresApi(this._client);

  final {{ client_class_name }} _client;

{% for procedure in procedures %}
  Future<{{ procedure.return_type }}> {{ procedure.method_name }}({{ procedure.args_name }} args, {
    CratestackRpcCallOptions? options,
  }) async {
    final body = await _client.adapter.call(
      'procedure.{{ procedure.name }}',
      args.toWire(),
      options: options,
    );
    return {{ procedure.return_decode_expr }};
  }

{% endfor %}
}
{% else %}
// cratestack#3: see `rest_procedures.dart.j2`'s identical guard for why.
class ProceduresApi {
  const ProceduresApi();
}
{% endif %}

final {{ provider_prefix }}ProceduresApiProvider = Provider<ProceduresApi>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).procedures;
});

{% include "riverpod/procedure_providers.dart.j2" %}
