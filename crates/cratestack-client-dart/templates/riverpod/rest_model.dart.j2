{% for import in imports %}
{{ import }}
{% endfor %}

{% include "riverpod/enums_and_data_classes.dart.j2" %}
class {{ selection.projected_class_name }} {
  const {{ selection.projected_class_name }}.fromWire(this._value);

  final CratestackValueMap _value;

{% for field in selection.scalar_fields %}
  {{ field.dart_type }} get {{ field.identifier }} => {{ field.decode_expr }};

{% endfor %}
{% for relation in selection.relations %}
{% if relation.is_list %}
  List<{{ relation.target_projected_class_name }}>? get {{ relation.identifier }} {
    final value = _value['{{ relation.wire_name }}'];
    if (value == null) return null;
    return cratestackAsValueList(value)
        .map((item) => {{ relation.target_projected_class_name }}.fromWire(cratestackAsValueMap(item)))
        .toList(growable: false);
  }

{% else %}
  {{ relation.target_projected_class_name }}? get {{ relation.identifier }} {
    final value = _value['{{ relation.wire_name }}'];
    if (value == null) return null;
    return {{ relation.target_projected_class_name }}.fromWire(cratestackAsValueMap(value));
  }

{% endif %}
{% endfor %}
}

class {{ model_api.api_class_name }} {
  const {{ model_api.api_class_name }}(this._client);

  final {{ client_class_name }} _client;

  Future<{{ model_api.list_return_type }}> list({
    CratestackListQuery? query,
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model_api.route }}',
      queryParameters: query?.toQueryParameters(),
      options: options,
    );
    return {{ model_api.list_decode_expr }};
  }

  Future<{% if model_api.is_paged %}Page<T>{% else %}List<T>{% endif %}> listView<T>({
    required CratestackProjection<T> projection,
    CratestackListQuery? query,
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model_api.route }}',
      queryParameters: cratestackMergeFetchIntoListQuery(query, projection.toFetchQuery()).toQueryParameters(),
      options: options,
    );
{% if model_api.is_paged %}
    return Page<T>.fromWire(
      cratestackAsValueMap(body),
      decodeItem: (item) => projection.fromWire(cratestackAsValueMap(item)),
    );
{% else %}
    return cratestackAsValueList(body)
        .map((item) => projection.fromWire(cratestackAsValueMap(item)))
        .toList(growable: false);
{% endif %}
  }

  Future<{{ model_api.model_name }}> get({{ model_api.primary_key_type }} id, {
    CratestackFetchQuery? query,
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model_api.detail_route }}',
      queryParameters: query?.toQueryParameters(),
      options: options,
    );
    return {{ model_api.model_name }}.fromWire(cratestackAsValueMap(body));
  }

  Future<T> getView<T>({{ model_api.primary_key_type }} id, {
    required CratestackProjection<T> projection,
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'GET',
      '{{ model_api.detail_route }}',
      queryParameters: projection.toFetchQuery().toQueryParameters(),
      options: options,
    );
    return projection.fromWire(cratestackAsValueMap(body));
  }

  Future<{{ model_api.model_name }}> create({{ model_api.create_input_name }} input, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'POST',
      '{{ model_api.route }}',
      body: input.toWire(),
      options: options,
    );
    return {{ model_api.model_name }}.fromWire(cratestackAsValueMap(body));
  }

  Future<{{ model_api.model_name }}> update({{ model_api.primary_key_type }} id, {{ model_api.update_input_name }} input, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'PATCH',
      '{{ model_api.detail_route }}',
      body: input.toWire(),
      options: options,
    );
    return {{ model_api.model_name }}.fromWire(cratestackAsValueMap(body));
  }

  Future<{{ model_api.model_name }}> delete({{ model_api.primary_key_type }} id, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'DELETE',
      '{{ model_api.detail_route }}',
      options: options,
    );
    return {{ model_api.model_name }}.fromWire(cratestackAsValueMap(body));
  }
}

final {{ accessor.provider_name }} = Provider<{{ accessor.api_class_name }}>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).{{ accessor.accessor }};
});
