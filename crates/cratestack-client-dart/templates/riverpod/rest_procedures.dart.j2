{% for import in imports %}
{{ import }}
{% endfor %}

{# cratestack#628: gated on `procedures | length > 0` — `riverpod_generator`
   writes no `.g.dart` file at all for a source file with zero `@riverpod`
   declarations (confirmed empirically), so an unconditional `part`
   directive here dangles into a real `uri_has_not_been_generated`
   `flutter analyze` error on a schema with zero procedures (the only
   source of `@riverpod` declarations in this file — see
   `procedure_providers.dart.j2`'s loop below). Kept as a template-only
   comment (not rendered into generated output) so a schema WITH
   procedures — the only case this comment would otherwise land inside —
   stays byte-identical to before this gate was added. See
   `ProceduresFileContext::part_file_name`'s doc for the fuller story,
   including why this precedent already existed one condition down for
   `mapper_part_file_name` (issue #325). #}
{% if procedures | length > 0 %}
part '{{ part_file_name }}';
{% endif %}
{% if data_classes | length > 0 %}
// issue #325: gated (unlike `part_file_name` above) because
// `dart_mappable_builder`, unlike `riverpod_generator`, skips writing a
// part file entirely rather than emitting an empty no-op one when its
// target file has zero `@MappableClass()` classes in it — a schema with
// zero procedures and no procedure-owned nested `type`s would otherwise
// hit a real `uri_does_not_exist` `flutter analyze` error (confirmed
// empirically — see `shared_types.dart.j2`'s identical guard).
part '{{ mapper_part_file_name }}';
// issue #668 phase 2: same gate as `mapper_part_file_name` above, for the
// same reason — `package:cratestack_builder`'s `PartBuilder` writes no
// output file when this source has zero `@CratestackBuilder()`-annotated
// classes.
part '{{ builder_part_file_name }}';
{% endif %}

{% include "riverpod/enums_and_data_classes.dart.j2" %}
{% if procedures | length > 0 %}
class ProceduresApi {
  const ProceduresApi(this._client);

  final {{ client_class_name }} _client;

{% for procedure in procedures %}
  Future<{{ procedure.return_type }}> {{ procedure.method_name }}({{ procedure.args_name }} args, {
    CratestackCallOptions? options,
  }) async {
    final body = await _client.execute(
      'POST',
      '{{ procedure.route }}',
      body: args.toWire(),
      options: options,
    );
    return {{ procedure.return_decode_expr }};
  }

{% endfor %}
}
{% else %}
// cratestack#627: a schema with zero procedures still gets a `ProceduresApi`
// (the `default` preset's own `apis.dart.j2` always renders one too —
// see `ProceduresFileContext::procedures`'s doc) but with no `_client`
// field: nothing in an empty class would ever read it, and an unread
// private field is a real `unused_field` `flutter analyze
// --fatal-warnings` failure.
class ProceduresApi {
  const ProceduresApi();
}
{% endif %}

final {{ provider_prefix }}ProceduresApiProvider = Provider<ProceduresApi>((ref) {
  return ref.watch({{ provider_prefix }}ClientProvider).procedures;
});

{% include "riverpod/procedure_providers.dart.j2" %}
