import 'package:grpc/grpc.dart';

import 'models.dart';
import 'runtime.dart';

// Field-number tables sourced from the schema's `.pb.lock` at generation
// time (`docs/design/protobuf.md` §3.3) — the same numbers the Rust
// server's mirror structs and `.proto` artifact use, so this client's
// wire bytes decode correctly on the real server.
const CratestackGrpcMessageRegistry _messages = {
{% for message in grpc.messages %}
  '{{ message.name }}': [
{% for field in message.fields %}
    CratestackGrpcFieldDescriptor(property: '{{ field.property }}', number: {{ field.number }}, kind: '{{ field.kind }}', repeated: {{ field.repeated }}{% if field.ref_name %}, refName: '{{ field.ref_name }}'{% endif %}{% if field.defaults_when_absent %}, defaultsWhenAbsent: true{% endif %}),
{% endfor %}
  ],
{% endfor %}
};

const CratestackGrpcEnumRegistry _enums = {
{% for enum in grpc.enums %}
  '{{ enum.name }}': {
{% for variant in enum.variants %}
    '{{ variant.0 }}': {{ variant.1 }},
{% endfor %}
  },
{% endfor %}
};

class {{ client_class_name }} {
  {{ client_class_name }}(this.runtime);

  final CratestackGrpcRuntime runtime;
{% for model in grpc.models %}
  late final {{ model.api_name }} {{ model.accessor }} = {{ model.api_name }}(runtime);
{% endfor %}
}

/// `list()`'s input covers the common list-projection controls
/// (`limit`/`offset`/`fields`/`include`/`sort`) — raw predicate queries
/// (`where`/`or`/structured filters) and per-relation field projection
/// (`includeFields`) are not wired into the generated gRPC client in this
/// pass; see this ticket's final report.
class CratestackGrpcListInput {
  const CratestackGrpcListInput({
    this.limit,
    this.offset,
    this.fields = const <String>[],
    this.include = const <String>[],
    this.sort,
  });

  final int? limit;
  final int? offset;
  final List<String> fields;
  final List<String> include;
  final String? sort;

  CratestackValueMap toWire() => {
        'limit': limit,
        'offset': offset,
        'fields': fields,
        'include': include,
        'sort': sort,
      };
}

{% for model in grpc.models %}
class {{ model.api_name }} {
  const {{ model.api_name }}(this._runtime);

  final CratestackGrpcRuntime _runtime;

  Future<Page<{{ model.name }}>> list([
    CratestackGrpcListInput input = const CratestackGrpcListInput(),
    CallOptions? options,
  ]) async {
    final result = await _runtime.unary(
      '{{ model.list_method.path }}',
      input.toWire(),
      _messages['{{ model.list_method.request_message }}']!,
      _messages['{{ model.list_method.response_message }}']!,
      _messages,
      _enums,
      options: options,
    );
    return Page<{{ model.name }}>.fromWire(
      result,
      decodeItem: (item) => {{ model.name }}.fromWire(cratestackAsValueMap(item)),
    );
  }

  Future<{{ model.name }}> get({{ model.primary_key_type }} id, {CallOptions? options}) async {
    final result = await _runtime.unary(
      '{{ model.get_method.path }}',
      {'id': id},
      _messages['{{ model.get_method.request_message }}']!,
      _messages['{{ model.get_method.response_message }}']!,
      _messages,
      _enums,
      options: options,
    );
    return {{ model.name }}.fromWire(result);
  }

{% if model.create_method %}
  Future<{{ model.name }}> create({{ model.create_input_name }} input, {CallOptions? options}) async {
    final result = await _runtime.unary(
      '{{ model.create_method.path }}',
      input.toWire(),
      _messages['{{ model.create_method.request_message }}']!,
      _messages['{{ model.create_method.response_message }}']!,
      _messages,
      _enums,
      options: options,
    );
    return {{ model.name }}.fromWire(result);
  }

{% endif %}
  Future<{{ model.name }}> update(
    {{ model.primary_key_type }} id,
    {{ model.update_input_name }} patch, {
    CallOptions? options,
  }) async {
    final result = await _runtime.unary(
      '{{ model.update_method.path }}',
      {'id': id, 'patch': patch.toWire()},
      _messages['{{ model.update_method.request_message }}']!,
      _messages['{{ model.update_method.response_message }}']!,
      _messages,
      _enums,
      options: options,
    );
    return {{ model.name }}.fromWire(result);
  }

  Future<void> delete({{ model.primary_key_type }} id, {CallOptions? options}) async {
    await _runtime.unary(
      '{{ model.delete_method.path }}',
      {'id': id},
      _messages['{{ model.delete_method.request_message }}']!,
      _messages['{{ model.delete_method.response_message }}']!,
      _messages,
      _enums,
      options: options,
    );
  }
}

{% endfor %}
