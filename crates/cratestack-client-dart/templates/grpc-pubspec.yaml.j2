name: {{ package_name }}
description: Generated CrateStack gRPC client package.
publish_to: 'none'
version: 0.1.0

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  grpc: ^5.1.0
  # cratestack#498: the gRPC preset's `grpc-library.dart.j2` re-exports
  # `src/models.dart` unchanged (the same generated model/filter classes
  # REST/RPC use), and those now carry real `Decimal` values — proto3
  # itself still maps `Decimal` to a plain `string` field
  # (`grpc/wire.rs`'s `GrpcWireKind::String`, deliberately out of #498's
  # scope), converted to/from that `Decimal` at the `Model.fromWire`/
  # `toWire()` boundary `grpc_runtime/decode.dart.j2`'s `decodeMessage`
  # already routes every message-shaped value through.
  decimal: ^3.2.6

dev_dependencies:
  flutter_lints: ^6.0.0
  flutter_test:
    sdk: flutter
