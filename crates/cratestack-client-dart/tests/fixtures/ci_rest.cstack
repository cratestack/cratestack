// Richer REST fixture for the Dart CI-verification harness (issue #300).
// Deliberately exercises more than the trivial `tiny_rest.cstack` path:
// multiple models, a relation, an enum (as a field, an array field, and a
// procedure return type), and both a query and a mutation procedure — the
// combination the historical `flutter analyze` bug (see `templates.rs`'s
// `REST_TEMPLATE_SPECS` comment) needed to actually be caught.

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth SessionUser {
  id Int
}

enum PostStatus {
  draft
  published
  archived
}

type PostStatusFilter {
  statuses PostStatus[]
}

model Author {
  id Int @id
  name String
  posts Post[] @relation(fields:[id],references:[authorId])
}

model Post {
  id Int @id
  title String
  status PostStatus
  published Boolean
  authorId Int
  author Author @relation(fields:[authorId],references:[id])

  @@allow("read", published || authorId == auth().id)
  @@allow("create", auth() != null)
  @@paged
}

procedure listPosts(filter: PostStatusFilter?): Post[]
  @allow(auth() != null)

mutation procedure currentStatus(postId: Int): PostStatus
  @allow(auth() != null)
