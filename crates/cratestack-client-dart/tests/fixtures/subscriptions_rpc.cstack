// Slice S6: the generated Dart client's subscriptions over SSE
// (`subscriptions_rpc_test.dart`, run by `just verify-dart`): a model feed
// and a subscription procedure.

transport rpc

model Note {
  id Int @id
  body String

  @@allow("read", true)
  @@emit(created)
  @@subscribe
}

// A `Uuid` id: over cbor-seq a model event's `event_id` and this `id` are byte
// strings (`subscriptions_rpc_cbor_seq_test.dart`, cratestack#1001).
model SeqNote {
  id Uuid @id
  body String

  @@allow("read", true)
  @@emit(created)
  @@subscribe
}

type Room {
  roomId String
}

type Line {
  body String
}

subscription procedure lines(args: Room): Line

// Marked `@frames(unsigned)`: a signing transport may open it sealed
// (`subscriptions_rpc_frames_test.dart`, cratestack#1378).
subscription procedure pulse(args: Room): Line
  @frames(unsigned)
