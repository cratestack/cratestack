// Regression fixture for the built-in `PageInput` procedure-argument
// type: `{ limit: Int?, offset: Int? }`, the request-side mirror of
// `Page<T>`'s response side. `datasource { provider = "none" }` keeps
// this Postgres-free, same as `no_database_procedures.cstack`.

datasource db {
  provider = "none"
}

type FeedReply {
  limit Int
  offset Int
}

procedure listFeed(page: PageInput): FeedReply
  @allow(auth() != null)
