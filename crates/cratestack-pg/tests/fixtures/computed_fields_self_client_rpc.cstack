datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

transport rpc

// `transport rpc` counterpart to `computed_fields_self_client.cstack` —
// proves the RPC self-client's decode targets (`crate::client::rpc`,
// `BatchableCall<C, super::wire::<Owner>>`) got the same fix as the REST
// ones, for both a model GET and a nested computed-bearing procedure
// output.
//
// `proxyUrl` is parameterized (`params: SelfClientRpcProxyParams?`)
// rather than bare so this fixture also exercises the generated RPC
// client's typed `computedParams` surface
// (`SelfClientRpcPhotoComputedParams`,
// `crates/cratestack-macros/src/client/computed_params.rs`,
// `crates/cratestack-macros/src/client/rpc/model.rs`'s `RpcGetInput`
// wiring) over `get`'s `Some`/`None`.
model SelfClientRpcPhoto {
  id Int @id
  storageKey String
  proxyUrl String @computed(params: SelfClientRpcProxyParams?)

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
}

type SelfClientRpcProxyParams {
  width Int?
}

type SelfClientRpcImage {
  storageKey String
  badge String @computed
}

type SelfClientRpcCard {
  cover SelfClientRpcImage
}

procedure getSelfClientRpcCard(storageKey: String): SelfClientRpcCard
  @allow(auth() != null)

// `List{owner}`/`Page` self-client procedure-client branches
// (`crates/cratestack-macros/src/client/rpc/procedure.rs`) had no fixture
// coverage at all before this: `listSelfClientRpcCards` exercises the
// `RpcStream<Item>` streaming branch, `pageSelfClientRpcCards` the
// `::cratestack::Page<super::wire::#owner_ident>` branch — both over the
// same computed-bearing `SelfClientRpcCard` (nested through
// `SelfClientRpcImage.badge`) `getSelfClientRpcCard` above already proves
// for the unary case.
procedure listSelfClientRpcCards(storageKey: String): SelfClientRpcCard[]
  @allow(auth() != null)

procedure pageSelfClientRpcCards(storageKey: String): Page<SelfClientRpcCard>
  @allow(auth() != null)
