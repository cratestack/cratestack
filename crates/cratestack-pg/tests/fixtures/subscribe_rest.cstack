// `@@subscribe` events pass the subscriber's read policy
// over REST (`tests/rpc_subscribe_read_policy/rest.rs`).

// REST: the feed is `GET /sub_notes/$subscribe` (slice S3).

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Caller {
  id Int
}

// Readable by its owner, unless archived.
model SubNote {
  id Int @id
  ownerId Int
  body String
  archived Boolean

  @@allow("read", ownerId == auth().id)
  @@deny("read", archived)
  @@allow("create", auth() != null)
  @@emit(created)
  @@subscribe
}
