// Regression fixture for cratestack#256: `collect_relation_order_targets`
// (the REST `?orderBy=`/`?sort=` match-arm generator) enumerated every
// simple to-one path through the relation graph at macro-expansion time
// -- exponential in to-one *connectivity* (fan-out), the same shape as
// the codegen bug fixed for the typed builder in #253/#252, just in the
// REST string-key surface instead of the typed relation-path types.
//
// A linear *chain* (each model with a single `parent`, like
// `relation_stress.cstack`) does not reproduce this: it never branches,
// so the old walk stayed O(n) on it regardless. This fixture instead
// fans each model in to its 3 most recent predecessors (`parent0..2`),
// which multiplies the simple-path count combinatorially. Measured
// against the pre-fix walk: 16 models with this shape took ~60s to
// `cargo check`, and 18 models did not finish within 5 minutes -- just
// building the `?orderBy=` match arms, no typed builder involved. Fixed
// by replacing the pre-enumerated
// match arms with a per-model `OrderCatalog` the REST dispatcher walks
// hop by hop at request time (see `cratestack_sql::order_catalog`) --
// codegen is now linear in `models × fields` however densely the models
// fan in to one another. Compiling within the normal test suite's time
// budget IS the regression guard, mirroring `relation_stress.rs`.

model OrderFanNode0 {
  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  count Int @range(min: 0, max: 1000)
}

model OrderFanNode1 {
  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  count Int @range(min: 0, max: 1000)
  parent0Id Cuid
  parent0 OrderFanNode0 @relation(fields: [parent0Id], references: [id])
}

model OrderFanNode2 {
  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  count Int @range(min: 0, max: 1000)
  parent0Id Cuid
  parent0 OrderFanNode0 @relation(fields: [parent0Id], references: [id])
  parent1Id Cuid
  parent1 OrderFanNode1 @relation(fields: [parent1Id], references: [id])
}

model OrderFanNode3 {
  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  count Int @range(min: 0, max: 1000)
  parent0Id Cuid
  parent0 OrderFanNode0 @relation(fields: [parent0Id], references: [id])
  parent1Id Cuid
  parent1 OrderFanNode1 @relation(fields: [parent1Id], references: [id])
  parent2Id Cuid
  parent2 OrderFanNode2 @relation(fields: [parent2Id], references: [id])
}

model OrderFanNode4 {
  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  count Int @range(min: 0, max: 1000)
  parent1Id Cuid
  parent1 OrderFanNode1 @relation(fields: [parent1Id], references: [id])
  parent2Id Cuid
  parent2 OrderFanNode2 @relation(fields: [parent2Id], references: [id])
  parent3Id Cuid
  parent3 OrderFanNode3 @relation(fields: [parent3Id], references: [id])
}

model OrderFanNode5 {
  id Cuid @id @default(dbgenerated())
  name String @length(min: 2, max: 64)
  count Int @range(min: 0, max: 1000)
  parent2Id Cuid
  parent2 OrderFanNode2 @relation(fields: [parent2Id], references: [id])
  parent3Id Cuid
  parent3 OrderFanNode3 @relation(fields: [parent3Id], references: [id])
  parent4Id Cuid
  parent4 OrderFanNode4 @relation(fields: [parent4Id], references: [id])
}

