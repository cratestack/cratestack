datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Operator {
  id Int
}

// Versioned + audit-enabled + event-emitting client-PK model. Exercises
// every fan-out path the batch primitives drive: per-item audit rows,
// per-item event outbox entries, savepoint rollback under If-Match
// mismatch, plus all three branches of batch_upsert (insert / update /
// dedup loud-fail).
//
// Named `BatchRow` (-> `batch_rows`) rather than `Entry`: originally
// chosen to sidestep the pluralizer's `entry` -> `entrys` bug
// (cratestack#504, fixed — `entry` now correctly pluralizes to
// `entries`). Left as `BatchRow` since nothing depends on the rename.
model BatchRow {
  id Int @id
  label String
  balance Int
  version Int @version

  @@audit
  @@emit(created, updated, deleted)
  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
  @@allow("delete", auth() != null)
}

// Composite-unique model (mirrors `Pair` in builder_extensions_tier2.cstack)
// used to exercise the per-item batch write paths against a real
// `UNIQUE(scope, key)` constraint that isn't the PK. Regression coverage
// for the batch equivalent of #267/#269: batch_create/batch_update/
// batch_upsert's terminal per-item write must classify SQLSTATE 23505 as
// CONFLICT instead of losing it as a generic DATABASE_ERROR.
model UniquePair {
  id Int @id
  scope String
  key String
  payload String

  @@audit
  @@emit(created, updated)
  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
}
