// The same model over RPC (`tests/subscription_cbor_seq_shapes.rs`, cratestack#1001).

transport rpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Caller {
  id Int
}

model SeqNote {
  id Uuid @id
  amount Decimal
  body String

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@emit(created)
  @@subscribe
}
