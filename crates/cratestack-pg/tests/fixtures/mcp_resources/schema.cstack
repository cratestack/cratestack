// cratestack#1040 (MCP phase 5): read-only resources, against real
// Postgres, by `tests/mcp_resources_pg.rs`. A resource URI's authority is
// the block's `name`, so this serves `cratestack://blog/posts` and
// `cratestack://blog/notes`, the URIs the story names. The file is
// deliberately *not* `blog.cstack`: its stem was the authority before the
// maintainer's decision on #1040, and with a different stem every URI
// these tests assert fails if the file's name ever leaks back in. The
// model names (and so the tables, `mcp_res_posts` / `mcp_res_notes`)
// appear in no URI.

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

mcp {
  name = "blog"
  expose = [resources]
}

auth Caller {
  id String
}

// A caller reads published posts and its own drafts. `secretNote` must never
// reach MCP output (`@server_only`), and `excerpt` must be resolved exactly
// as REST resolves it (`@computed`): both at once, on one model, because the
// procedure-output composer is known to leak `@server_only` on such models
// and resources must not go through it.
model McpResPost {
  id Int @id
  authorId String
  title String
  published Boolean
  secretNote String @server_only
  excerpt String @computed
  author McpResAuthor @relation(fields:[authorId],references:[id])

  @@allow("read", published || authorId == auth().id)
  @@mcp(resource: "posts")
}

// Not exposed. A post's author is hidden from every caller but itself and
// carries a `@server_only` field: a resource record must name neither,
// since REST's default read includes no relation (cratestack#1040 review).
// Its model name, table name and any segment-like spelling of either must
// not resolve as a resource.
model McpResAuthor {
  id String @id
  name String
  passwordHash String @server_only

  @@allow("read", auth() != null && auth().id == id)
}

// A lowered page ceiling (ADR 0002 Q3).
model McpResNote {
  id String @id
  ownerId String
  body String

  @@allow("read", auth() != null && auth().id == ownerId)
  @@mcp(resource: "notes", max_page_size: 20)
}
