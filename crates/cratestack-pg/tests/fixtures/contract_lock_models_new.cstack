// `contract_lock_models_old.cstack` after an optional field (`tag`, additive
// and so wire-compatible, but it moves every `Note` op's digest) and a
// widened read policy (server-only).

transport rpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Operator {
  id Int
}

model Note {
  id Int @id
  body String
  tag String?

  @@allow("read", auth() != null || auth() == null)
  @@allow("create", auth() != null)
}
