// cratestack#1359: a model with a `Uuid` primary key, a `Uuid` foreign key and
// a nullable `Uuid`, served over REST. A Dart client sends those as CBOR
// text; the server must accept them in create/update bodies and in
// `FindMany` filters. Dedicated to `tests/uuid_end_to_end.rs`.

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Operator {
  id Int
}

model UuidRestDoc {
  id Uuid @id
  ownerId Uuid
  parentId Uuid?
  title String

  @@allow("all", auth() != null)
}

procedure findUuidRestDocs(query: FindMany<UuidRestDoc>): UuidRestDoc[]
  @allow(auth() != null)
