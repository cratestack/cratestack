// `@@subscribe` events pass the subscriber's read policy
// (`tests/rpc_subscribe_read_policy.rs`).

transport rpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Caller {
  id Int
}

// Readable by its owner, unless archived.
model SubNote {
  id Int @id
  ownerId Int
  body String
  archived Boolean

  @@allow("read", ownerId == auth().id)
  @@deny("read", archived)
  @@allow("create", auth() != null)
  @@allow("update", ownerId == auth().id)
  @@emit(created, updated)
  @@subscribe
}

// A unique column: changing it takes `FOR UPDATE`, not `FOR NO KEY UPDATE`.
model SubKeyed {
  id Int @id
  code String @unique
  n Int

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
  @@emit(created, updated)
  @@subscribe
}

// Audited as well as subscribed: both read the row before an update, once.
model SubAudited {
  id Int @id
  body String

  @@audit
  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
  @@emit(created, updated)
  @@subscribe
}

// The policy reads a column the event payload never carries, so no event
// could be decided: the subscription is refused when it opens.
model SubSecret {
  id Int @id
  hidden Boolean @server_only

  @@allow("read", auth() != null)
  @@deny("read", hidden)
  @@emit(created)
  @@subscribe
}
