// Regression fixture for the built-in `FindMany<Model>` procedure-argument
// type: search-with-filters for procedures, reusing the exact same
// `where=`/`sort=` grammar and per-model validation a `@@paged` model's
// own generated `list` route already uses (see
// `cratestack-macros/src/axum/model/find_many_query.rs`).

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Post {
  id Int @id
  title String
  published Boolean
  authorId Int

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
}

procedure searchPosts(query: FindMany<Post>): Post[]
  @allow(auth() != null)
