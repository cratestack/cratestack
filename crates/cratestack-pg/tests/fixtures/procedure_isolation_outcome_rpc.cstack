// `procedure_isolation_outcome.cstack` on `transport rpc` — see that file.

transport rpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth Operator {
  id Int
}

model OutAccount {
  id Int @id
  balance Int

  @@allow("read", auth() != null)
  @@allow("create", auth() != null)
  @@allow("update", auth() != null)
}

type Probe {
  nonce String
}

type Report {
  level String
}

type Transfer {
  accountId Int
  peerId Int
  amount Int
}

type Statement {
  accountId Int
  after Int
  peerId Int
  peerBalance Int @computed
}

mutation procedure alwaysConflict(args: Probe): Report
  @isolation("serializable")
  @allow(auth() != null)

mutation procedure refuse(args: Probe): Report
  @isolation("serializable")
  @allow(auth() != null)

mutation procedure debitStatement(args: Transfer): Statement
  @isolation("repeatable_read")
  @allow(auth() != null)

mutation procedure debitStatementPlain(args: Transfer): Statement
  @allow(auth() != null)
