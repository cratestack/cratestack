The same operations as hooks, inside a component (note the `.hooks` subpath):

```tsx
import { {{ models[0].list_hook }}, {{ models[0].get_hook }} } from "{{ package_name }}/models/{{ models[0].file_stem }}.hooks";

const { data: items } = {{ models[0].list_hook }}(runtime);
const { data: item } = {{ models[0].get_hook }}(runtime, id); // id may be null/undefined — skips the request
{% if models[0].allows_create %}
const { trigger: create{{ models[0].name }} } = {{ models[0].create_hook }}(runtime);
{% endif %}
const { trigger: update{{ models[0].name }} } = {{ models[0].update_hook }}(runtime, id);
const { trigger: delete{{ models[0].name }} } = {{ models[0].delete_hook }}(runtime, id);
```
{% endif %}

