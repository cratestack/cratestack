import { CratestackRuntime, type CratestackClientOptions, type CratestackResponseEnvelope } from "./runtime.js";
import { reviveDecimalFields, revivePagedDecimalFields, reviveDecimalScalar } from "./models.js";
import type {
{% for interface in interfaces %}
  {{ interface.name }},
{% endfor %}
{% for enum in enums %}
  {{ enum.name }},
{% endfor %}
  Page,
} from "./models.js";
import {
  toSearchQuery,
  withIfMatchHeader,
  type CratestackQueryRequestConfig,
  type CratestackRequestConfig,
  type CratestackWriteRequestConfig,
} from "./queries.js";

export class {{ client_class_name }} {
  readonly runtime: CratestackRuntime;
  readonly procedures: ProceduresApi;
{% for model in models %}
  readonly {{ model.accessor }}: {{ model.api_name }};
{% endfor %}

  constructor(originOrRuntime: string | CratestackRuntime, options: CratestackClientOptions = {}) {
    this.runtime = typeof originOrRuntime === "string"
      ? new CratestackRuntime(originOrRuntime, options)
      : originOrRuntime;
    this.procedures = new ProceduresApi(this.runtime);
{% for model in models %}
    this.{{ model.accessor }} = new {{ model.api_name }}(this.runtime);
{% endfor %}
  }
}

{% for model in models %}
export class {{ model.api_name }} {
  constructor(private readonly runtime: CratestackRuntime) {}

  list(options: CratestackQueryRequestConfig{% if model.computed_params_interface %}<{{ model.computed_params_interface }}>{% endif %} = {}): Promise<{{ model.list_return_type }}> {
    return this.runtime.get<unknown>("{{ model.route }}", {
      headers: options.headers,
      query: toSearchQuery(options.query),
      signal: options.signal,
    }).then((value) => {% if model.is_paged %}revivePagedDecimalFields{% else %}reviveDecimalFields{% endif %}(value, '{{ model.decimal_shape_name }}') as {{ model.list_return_type }});
  }

  get(id: {{ model.primary_key_type }}, options: CratestackQueryRequestConfig{% if model.computed_params_interface %}<{{ model.computed_params_interface }}>{% endif %} = {}): Promise<{{ model.name }}> {
    return this.runtime.get<unknown>(`{{ model.route }}/${encodeURIComponent(String(id))}`, {
      headers: options.headers,
      query: toSearchQuery(options.query),
      signal: options.signal,
    }).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }

  // Same call as `get`, but returns the response alongside the record
  // (issue #610) — read `.response.headers.get("etag")` off the result
  // to get the value `update`/`delete`'s `ifMatch` option needs.
  getWithResponse(
    id: {{ model.primary_key_type }},
    options: CratestackQueryRequestConfig{% if model.computed_params_interface %}<{{ model.computed_params_interface }}>{% endif %} = {},
  ): Promise<CratestackResponseEnvelope<{{ model.name }}>> {
    return this.runtime.getWithResponse<unknown>(`{{ model.route }}/${encodeURIComponent(String(id))}`, {
      headers: options.headers,
      query: toSearchQuery(options.query),
      signal: options.signal,
    }).then((result) => ({
      value: reviveDecimalFields(result.value, '{{ model.decimal_shape_name }}') as {{ model.name }},
      response: result.response,
    }));
  }

{% if model.allows_create %}
  create(input: {{ model.create_input_name }}, options: CratestackRequestConfig = {}): Promise<{{ model.name }}> {
    return this.runtime.post<unknown>("{{ model.route }}", input, options)
      .then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }

{% endif %}
  update(
    id: {{ model.primary_key_type }},
    input: {{ model.update_input_name }},
    options: CratestackWriteRequestConfig = {},
  ): Promise<{{ model.name }}> {
    return this.runtime.patch<unknown>(`{{ model.route }}/${encodeURIComponent(String(id))}`, input, {
      headers: withIfMatchHeader(options.headers, options.ifMatch),
      signal: options.signal,
    })
      .then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }

  delete(id: {{ model.primary_key_type }}, options: CratestackWriteRequestConfig = {}): Promise<void> {
    return this.runtime.delete<void>(`{{ model.route }}/${encodeURIComponent(String(id))}`, {
      headers: withIfMatchHeader(options.headers, options.ifMatch),
      signal: options.signal,
    });
  }
}

{% endfor %}
export class ProceduresApi {
  constructor(private readonly runtime: CratestackRuntime) {}

{% for procedure in procedures %}
{% if procedure.decimal_revival_kind == "scalar" %}
  {{ procedure.method_name }}(args: {{ procedure.args_name }}, options: CratestackRequestConfig = {}): Promise<{{ procedure.return_type }}> {
    return this.runtime.post<unknown>("{{ procedure.route }}", args, options)
      .then((value) => reviveDecimalScalar(value) as {{ procedure.return_type }});
  }
{% else %}
  {{ procedure.method_name }}(args: {{ procedure.args_name }}, options: CratestackRequestConfig = {}): Promise<{{ procedure.return_type }}> {
    return this.runtime.post<unknown>("{{ procedure.route }}", args, options)
      .then((value) => {% if procedure.decimal_paged %}revivePagedDecimalFields{% else %}reviveDecimalFields{% endif %}(value, '{{ procedure.decimal_shape_name }}') as {{ procedure.return_type }});
  }
{% endif %}

{% endfor %}
}
