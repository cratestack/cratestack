import {
  useMutation,
  useQuery,
  type UseMutationOptions,
  type UseQueryOptions,
} from "@tanstack/react-query";
import type { {{ client_class_name }}, GrpcListInput } from "./client.js";
import type {
{% for interface in interfaces %}
  {{ interface.name }},
{% endfor %}
{% for enum in enums %}
  {{ enum.name }},
{% endfor %}
  Page,
} from "./models.js";
import type { CratestackGrpcCallOptions } from "./runtime.js";

// No procedure hooks here: `transport grpc` schemas never route
// procedures over gRPC-Web (ticket #171 didn't wire them into the
// generated tonic service — see `crate::grpc`'s module doc), so
// `procedures`/`query_procedures`/`mutation_procedures` are always empty
// for this transport.

export const cratestackQueryKeys = {
{% for model in grpc.models %}
  {{ model.name | lower }}List: (input?: GrpcListInput) => ["model.{{ model.name }}.list", input] as const,
  {{ model.name | lower }}Detail: (id: {{ model.primary_key_type }}) => ["model.{{ model.name }}.get", id] as const,
{% endfor %}
};

{% for model in grpc.models %}
export function use{{ model.name }}ListQuery(
  client: {{ client_class_name }},
  input: GrpcListInput = {},
  options: CratestackGrpcCallOptions & {
    queryOptions?: Omit<UseQueryOptions<Page<{{ model.name }}>>, "queryKey" | "queryFn">;
  } = {},
) {
  return useQuery({
    ...options.queryOptions,
    queryKey: cratestackQueryKeys.{{ model.name | lower }}List(input),
    queryFn: ({ signal }) => client.{{ model.accessor }}.list(input, { ...options, signal }),
  });
}

export function use{{ model.name }}Query(
  client: {{ client_class_name }},
  id: {{ model.primary_key_type }},
  options: CratestackGrpcCallOptions & {
    queryOptions?: Omit<UseQueryOptions<{{ model.name }}>, "queryKey" | "queryFn">;
  } = {},
) {
  return useQuery({
    ...options.queryOptions,
    queryKey: cratestackQueryKeys.{{ model.name | lower }}Detail(id),
    queryFn: ({ signal }) => client.{{ model.accessor }}.get(id, { ...options, signal }),
  });
}

{% if model.create_method %}
export function useCreate{{ model.name }}Mutation(
  client: {{ client_class_name }},
  options?: UseMutationOptions<{{ model.name }}, Error, {{ model.create_input_name }}>,
) {
  return useMutation({
    ...options,
    mutationKey: ["create{{ model.name }}"],
    mutationFn: (input) => client.{{ model.accessor }}.create(input),
  });
}

{% endif %}
export function useUpdate{{ model.name }}Mutation(
  client: {{ client_class_name }},
  options?: UseMutationOptions<{{ model.name }}, Error, { id: {{ model.primary_key_type }}; input: {{ model.update_input_name }} }>,
) {
  return useMutation({
    ...options,
    mutationKey: ["update{{ model.name }}"],
    mutationFn: ({ id, input }) => client.{{ model.accessor }}.update(id, input),
  });
}

export function useDelete{{ model.name }}Mutation(
  client: {{ client_class_name }},
  options?: UseMutationOptions<void, Error, { id: {{ model.primary_key_type }} }>,
) {
  return useMutation({
    ...options,
    mutationKey: ["delete{{ model.name }}"],
    mutationFn: ({ id }) => client.{{ model.accessor }}.delete(id),
  });
}

{% endfor %}
