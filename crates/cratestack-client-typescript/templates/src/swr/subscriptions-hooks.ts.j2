// `useSubscription` (slice S6, docs/design/subscriptions-websocket.md §8):
// any subscription of the package's client as SWR data, through
// `swr/subscription`. `data` is the latest item; `error` the terminal
// error or the refusal. Unmounting (or a new key) cancels the
// subscription. Kept out of `./index` like every other hook here, so the
// package root stays importable without `swr`/`react`.
//
//   const { data } = useSubscription(["notes", ownerId], (signal) =>
//     client.notes.subscribe({ filters: [{ key: "ownerId", value: String(ownerId) }] }, { signal }));

import useSWRSubscription, { type SWRSubscriptionOptions } from "swr/subscription";

export function useSubscription<T>(
  key: string | readonly unknown[] | null,
  open: (signal: AbortSignal) => AsyncIterable<T>,
) {
  return useSWRSubscription<T, Error>(key, (_key: unknown, { next }: SWRSubscriptionOptions<T, Error>) => {
    const controller = new AbortController();
    void (async () => {
      try {
        for await (const item of open(controller.signal)) next(null, item);
      } catch (error) {
        if (!controller.signal.aborted) next(error instanceof Error ? error : new Error(String(error)));
      }
    })();
    return () => controller.abort();
  });
}
