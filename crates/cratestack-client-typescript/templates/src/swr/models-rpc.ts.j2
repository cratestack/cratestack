// Generated per-model module for the `swr` preset (issue #304): this
// model's types plus a plain, framework-free `async` function per CRUD
// operation. No client class, no React import — every function takes a
// `CratestackRpcRuntime` as its first argument, so it's callable from a
// React component, a server action, a plain Node script, or a test.
//
// Ownership rule: a type used by exactly one model is defined here,
// inline; a type used by two or more models (or referenced only by a
// procedure, or declared but unused) lives in `./shared` and is imported
// instead. See `cratestack-client-typescript`'s
// `src/swr/ownership.rs::compute_type_ownership` for the computation
// that decided this file's inline types vs. its imports. Imports of
// another model's own type (a relation field, e.g. `author: User`) are
// always `import type` — never a value import — so two models that
// reference each other (a relation cycle) can never become a runtime
// import cycle, only a type-only one, which TypeScript tolerates fine.

import type { CratestackRpcRuntime, CratestackRpcCallOptions } from "../runtime.js";
import { toRpcListInput, type CratestackRpcListQuery } from "../queries.js";
// cratestack#498: see `models-rest.ts.j2`'s identical import for why
// `Decimal` is unconditional and `reviveDecimalFields` is a real (not
// type-only) import.
import { reviveDecimalFields, revivePagedDecimalFields, type Decimal } from "./shared.js";
{% for import in imports %}
import type { {{ import.type_names_joined }} } from "{{ import.path }}";
{% endfor %}

{% for enum in owned_enums %}
export type {{ enum.name }} = {{ enum.union }};
export const {{ enum.name }}Values = [
{% for value in enum.values %}
  "{{ value }}",
{% endfor %}
] as const satisfies readonly {{ enum.name }}[];

{% endfor %}
{% for interface in owned_interfaces %}
export interface {{ interface.name }} {
{% if interface.has_fields %}
{% for field in interface.fields %}
  {{ field.property }}{% if field.optional %}?{% endif %}: {{ field.type_name }};
{% endfor %}
{% endif %}
}

{% endfor %}
export interface {{ model_interface.name }} {
{% if model_interface.has_fields %}
{% for field in model_interface.fields %}
  {{ field.property }}{% if field.optional %}?{% endif %}: {{ field.type_name }};
{% endfor %}
{% endif %}
}

{% if create_input %}
export interface {{ create_input.name }} {
{% if create_input.has_fields %}
{% for field in create_input.fields %}
  {{ field.property }}{% if field.optional %}?{% endif %}: {{ field.type_name }};
{% endfor %}
{% endif %}
}

{% endif %}
export interface {{ update_input.name }} {
{% if update_input.has_fields %}
{% for field in update_input.fields %}
  {{ field.property }}{% if field.optional %}?{% endif %}: {{ field.type_name }};
{% endfor %}
{% endif %}
}

{% if model.computed_params_interface %}
/** Extends {@link CratestackRpcCallOptions} with the typed `computedParams`
 *  escape hatch for {@link {{ get_fn }} } (`docs/design/computed-fields.md`)
 *  — {{ model.name }} declares at least one parameterized
 *  `@computed(params: <Type>?)` field, so (unlike a model with none) it
 *  gets this option, rather than the bare `CratestackRpcCallOptions`. */
export interface {{ model.api_name }}GetOptions extends CratestackRpcCallOptions {
  computedParams?: {{ model.computed_params_interface }};
}

{% endif %}
export async function {{ list_fn }}(
  runtime: CratestackRpcRuntime,
  query: CratestackRpcListQuery{% if model.computed_params_interface %}<{{ model.computed_params_interface }}>{% endif %} = {},
  options: CratestackRpcCallOptions = {},
): Promise<{{ model.list_return_type }}> {
  return runtime.call<Record<string, unknown>, unknown>(
    "model.{{ model.name }}.list",
    toRpcListInput(query),
    options,
  ).then((value) => {% if model.is_paged %}revivePagedDecimalFields{% else %}reviveDecimalFields{% endif %}(value, '{{ model.decimal_shape_name }}') as {{ model.list_return_type }});
}

{% if model.computed_params_interface %}
export async function {{ get_fn }}(
  runtime: CratestackRpcRuntime,
  id: {{ model.primary_key_type }},
  options: {{ model.api_name }}GetOptions = {},
): Promise<{{ model_interface.name }}> {
  return runtime.call<Record<string, unknown>, unknown>(
    "model.{{ model.name }}.get",
    options.computedParams !== undefined
      ? { id, computedParams: JSON.stringify(options.computedParams) }
      : { id },
    options,
  ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model_interface.name }});
}
{% else %}
export async function {{ get_fn }}(
  runtime: CratestackRpcRuntime,
  id: {{ model.primary_key_type }},
  options: CratestackRpcCallOptions = {},
): Promise<{{ model_interface.name }}> {
  return runtime.call<{ id: {{ model.primary_key_type }} }, unknown>(
    "model.{{ model.name }}.get",
    { id },
    options,
  ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model_interface.name }});
}
{% endif %}

{% if create_input %}
export async function {{ create_fn }}(
  runtime: CratestackRpcRuntime,
  input: {{ create_input.name }},
  options: CratestackRpcCallOptions = {},
): Promise<{{ model_interface.name }}> {
  return runtime.call<{{ create_input.name }}, unknown>(
    "model.{{ model.name }}.create",
    input,
    options,
  ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model_interface.name }});
}

{% endif %}
export async function {{ update_fn }}(
  runtime: CratestackRpcRuntime,
  id: {{ model.primary_key_type }},
  patch: {{ update_input.name }},
  options: CratestackRpcCallOptions = {},
): Promise<{{ model_interface.name }}> {
  return runtime.call<{ id: {{ model.primary_key_type }}; patch: {{ update_input.name }} }, unknown>(
    "model.{{ model.name }}.update",
    { id, patch },
    options,
  ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model_interface.name }});
}

export async function {{ delete_fn }}(
  runtime: CratestackRpcRuntime,
  id: {{ model.primary_key_type }},
  options: CratestackRpcCallOptions = {},
): Promise<void> {
  return runtime.call<{ id: {{ model.primary_key_type }} }, void>(
    "model.{{ model.name }}.delete",
    { id },
    options,
  );
}
