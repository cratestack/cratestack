// Generated CrateStack TypeScript gRPC-Web runtime for `transport grpc`
// schemas (`docs/design/protobuf.md` §7.4). Hand-rolled over `fetch` —
// same philosophy as the RPC transport's runtime — with a minimal
// protobuf wire codec for the bounded field-type set §4.1 maps `.cstack`
// scalars onto (int64, double, bool, string, bytes, `Timestamp`, enum,
// embedded message, repeated). No `grpc-web` or protobuf runtime npm
// dependency.
//
// Binary mode only (`application/grpc-web+proto`) — see this ticket's
// final report for why binary was chosen over the base64 text mode.

export type JsonPrimitive = string | number | boolean | null;
export type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };

// ---------------------------------------------------------------------
// Wire primitives: varint, fixed64, length-delimited framing.
// ---------------------------------------------------------------------

const WIRE_VARINT = 0;
const WIRE_FIXED64 = 1;
const WIRE_LENGTH_DELIMITED = 2;

function encodeVarint(value: bigint): number[] {
  // Standard (non-zigzag) protobuf varint: a negative `int64` always
  // encodes as the 10-byte two's-complement pattern — masking to 64 bits
  // up front makes that fall out of the same loop as the positive case.
  let v = value & 0xffffffffffffffffn;
  const bytes: number[] = [];
  do {
    let byte = Number(v & 0x7fn);
    v >>= 7n;
    if (v !== 0n) {
      byte |= 0x80;
    }
    bytes.push(byte);
  } while (v !== 0n);
  return bytes;
}

/** `Uint8Array` indexing types as `number | undefined` under the
 *  generated tsconfig's `noUncheckedIndexedAccess` — every call site here
 *  has already bounds-checked before indexing, so this just narrows back
 *  to `number` with a message if that invariant is ever violated, rather
 *  than sprinkling non-null assertions through the wire code. */
function byteAt(bytes: Uint8Array, index: number): number {
  const value = bytes[index];
  if (value === undefined) {
    throw new CratestackGrpcTransportError(`byte offset ${index} out of range`);
  }
  return value;
}

function decodeVarint(bytes: Uint8Array, offset: number): [bigint, number] {
  let result = 0n;
  let shift = 0n;
  let pos = offset;
  for (;;) {
    if (pos >= bytes.length) {
      throw new CratestackGrpcTransportError("truncated varint in message body");
    }
    const byte = byteAt(bytes, pos);
    pos += 1;
    result |= BigInt(byte & 0x7f) << shift;
    if ((byte & 0x80) === 0) {
      break;
    }
    shift += 7n;
  }
  // Reinterpret as signed 64-bit (two's complement) when the high bit of
  // a full-width value is set — matches how a negative `int64` was framed
  // by `encodeVarint`.
  if (result >= 1n << 63n) {
    result -= 1n << 64n;
  }
  return [result, pos];
}

function encodeTag(fieldNumber: number, wireType: number): number[] {
  return encodeVarint(BigInt((fieldNumber << 3) | wireType));
}

function encodeFixed64Double(value: number): Uint8Array {
  const buffer = new ArrayBuffer(8);
  new DataView(buffer).setFloat64(0, value, true);
  return new Uint8Array(buffer);
}

function decodeFixed64Double(bytes: Uint8Array, offset: number): number {
  const view = new DataView(bytes.buffer, bytes.byteOffset + offset, 8);
  return view.getFloat64(0, true);
}

function concatBytes(chunks: (number[] | Uint8Array)[]): Uint8Array {
  const total = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
  const out = new Uint8Array(total);
  let offset = 0;
  for (const chunk of chunks) {
    out.set(chunk, offset);
    offset += chunk.length;
  }
  return out;
}

// ---------------------------------------------------------------------
// google.protobuf.Timestamp <-> ISO 8601 string (`.cstack DateTime`'s TS
// type, `crate::types::ts_type`). A fixed 2-field message
// (`seconds: int64 = 1`, `nanos: int32 = 2`) — built in directly rather
// than through the generic message registry, since it's the one message
// shape every schema shares regardless of what it declares.
// ---------------------------------------------------------------------

function encodeTimestamp(iso: string): Uint8Array {
  const ms = Date.parse(iso);
  if (Number.isNaN(ms)) {
    throw new CratestackGrpcTransportError(`invalid DateTime value: ${iso}`);
  }
  const seconds = Math.floor(ms / 1000);
  const nanos = (ms % 1000) * 1_000_000;
  const parts: number[][] = [];
  if (seconds !== 0) {
    parts.push(encodeTag(1, WIRE_VARINT), encodeVarint(BigInt(seconds)));
  }
  if (nanos !== 0) {
    parts.push(encodeTag(2, WIRE_VARINT), encodeVarint(BigInt(nanos)));
  }
  return concatBytes(parts);
}

function decodeTimestamp(bytes: Uint8Array): string {
  let seconds = 0n;
  let nanos = 0n;
  for (const { fieldNumber, wireType, offset, next } of iterateFields(bytes)) {
    if (fieldNumber === 1 && wireType === WIRE_VARINT) {
      [seconds] = decodeVarint(bytes, offset);
    } else if (fieldNumber === 2 && wireType === WIRE_VARINT) {
      [nanos] = decodeVarint(bytes, offset);
    }
    void next;
  }
  const ms = Number(seconds) * 1000 + Number(nanos) / 1_000_000;
  return new Date(ms).toISOString();
}

// ---------------------------------------------------------------------
// Data-driven message codec — every generated `*Fields` descriptor table
// in `client.ts` is walked by these two functions, so there is exactly
// one encoder/decoder implementation regardless of how many message
// shapes a schema declares.
// ---------------------------------------------------------------------

export type GrpcWireKind =
  | "int64"
  | "double"
  | "bool"
  | "string"
  | "bytes"
  | "timestamp"
  | "enum"
  | "message";

export interface GrpcFieldDescriptor {
  readonly property: string;
  readonly number: number;
  readonly kind: GrpcWireKind;
  readonly repeated: boolean;
  readonly refName?: string;
  /** True for the rare field that uses proto3 *implicit* presence
   *  (today: `PageInfo.hasNextPage`/`hasPreviousPage`) — an absent wire
   *  tag means the value genuinely *is* the type's zero value, not "not
   *  provided", so {@link decodeMessage} fills in the zero value instead
   *  of leaving the property `undefined`. */
  readonly defaultsWhenAbsent?: boolean;
}

function zeroValue(kind: GrpcWireKind): unknown {
  switch (kind) {
    case "int64":
    case "double":
      return 0;
    case "bool":
      return false;
    case "string":
      return "";
    case "bytes":
      return new Uint8Array(0);
    case "timestamp":
      return new Date(0).toISOString();
    case "enum":
    case "message":
      return undefined;
  }
}

export type GrpcMessageRegistry = Readonly<Record<string, readonly GrpcFieldDescriptor[]>>;
export type GrpcEnumRegistry = Readonly<Record<string, Readonly<Record<string, number>>>>;

function encodeScalar(kind: GrpcWireKind, value: unknown, refName: string | undefined, enums: GrpcEnumRegistry, messages: GrpcMessageRegistry): { wireType: number; bytes: number[] | Uint8Array } {
  switch (kind) {
    case "int64":
      return { wireType: WIRE_VARINT, bytes: encodeVarint(BigInt(value as number)) };
    case "bool":
      return { wireType: WIRE_VARINT, bytes: encodeVarint((value as boolean) ? 1n : 0n) };
    case "double":
      return { wireType: WIRE_FIXED64, bytes: encodeFixed64Double(value as number) };
    case "string":
      return { wireType: WIRE_LENGTH_DELIMITED, bytes: new TextEncoder().encode(value as string) };
    case "bytes":
      return { wireType: WIRE_LENGTH_DELIMITED, bytes: value as Uint8Array };
    case "timestamp":
      return { wireType: WIRE_LENGTH_DELIMITED, bytes: encodeTimestamp(value as string) };
    case "enum": {
      const table = enums[refName ?? ""] ?? {};
      const number = table[value as string];
      if (number === undefined) {
        throw new CratestackGrpcTransportError(`unknown enum value '${value}' for ${refName}`);
      }
      return { wireType: WIRE_VARINT, bytes: encodeVarint(BigInt(number)) };
    }
    case "message": {
      const fields = messages[refName ?? ""];
      if (!fields) {
        throw new CratestackGrpcTransportError(`unknown message type '${refName}'`);
      }
      return {
        wireType: WIRE_LENGTH_DELIMITED,
        bytes: encodeMessage(value as Record<string, unknown>, fields, messages, enums),
      };
    }
  }
}

/** Encodes a plain object against a generated field-descriptor table.
 *  `undefined`/`null` on a scalar field omits it (proto3 explicit
 *  presence, `docs/design/protobuf.md` §4.4 — matches `None` on the Rust
 *  side); an empty array on a repeated field also omits it (proto3
 *  repeated fields have no separate presence bit — an empty and an
 *  absent list are the same bytes either way). */
export function encodeMessage(
  value: Record<string, unknown>,
  descriptors: readonly GrpcFieldDescriptor[],
  messages: GrpcMessageRegistry,
  enums: GrpcEnumRegistry,
): Uint8Array {
  const parts: (number[] | Uint8Array)[] = [];
  for (const field of descriptors) {
    const raw = value[field.property];
    if (raw === undefined || raw === null) {
      continue;
    }
    const values = field.repeated ? (raw as unknown[]) : [raw];
    for (const item of values) {
      const { wireType, bytes } = encodeScalar(field.kind, item, field.refName, enums, messages);
      parts.push(encodeTag(field.number, wireType));
      if (wireType === WIRE_LENGTH_DELIMITED) {
        parts.push(encodeVarint(BigInt(bytes.length)));
      }
      parts.push(bytes);
    }
  }
  return concatBytes(parts);
}

interface RawField {
  fieldNumber: number;
  wireType: number;
  offset: number;
  next: number;
}

/** Walks a message's top-level fields (not recursive — nested messages
 *  are decoded by a fresh call once their length-delimited span is
 *  sliced out), yielding each field's wire type and the byte offset its
 *  value starts at. */
function* iterateFields(bytes: Uint8Array): Generator<RawField> {
  let pos = 0;
  while (pos < bytes.length) {
    const [tag, afterTag] = decodeVarint(bytes, pos);
    const fieldNumber = Number(tag >> 3n);
    const wireType = Number(tag & 0x7n);
    let valueStart = afterTag;
    let next: number;
    if (wireType === WIRE_VARINT) {
      const [, afterValue] = decodeVarint(bytes, valueStart);
      next = afterValue;
    } else if (wireType === WIRE_FIXED64) {
      next = valueStart + 8;
    } else if (wireType === WIRE_LENGTH_DELIMITED) {
      const [len, afterLen] = decodeVarint(bytes, valueStart);
      valueStart = afterLen;
      next = afterLen + Number(len);
    } else {
      throw new CratestackGrpcTransportError(`unsupported wire type ${wireType} in message body`);
    }
    yield { fieldNumber, wireType, offset: valueStart, next };
    pos = next;
  }
}

function decodeScalar(kind: GrpcWireKind, bytes: Uint8Array, refName: string | undefined, messages: GrpcMessageRegistry, enums: GrpcEnumRegistry): unknown {
  switch (kind) {
    case "int64":
      return Number(decodeVarint(bytes, 0)[0]);
    case "bool":
      return decodeVarint(bytes, 0)[0] !== 0n;
    case "double":
      return decodeFixed64Double(bytes, 0);
    case "string":
      return new TextDecoder().decode(bytes);
    case "bytes":
      return bytes;
    case "timestamp":
      return decodeTimestamp(bytes);
    case "enum": {
      const table = enums[refName ?? ""] ?? {};
      const number = Number(decodeVarint(bytes, 0)[0]);
      const name = Object.entries(table).find(([, n]) => n === number)?.[0];
      return name ?? String(number);
    }
    case "message": {
      const fields = messages[refName ?? ""];
      if (!fields) {
        throw new CratestackGrpcTransportError(`unknown message type '${refName}'`);
      }
      return decodeMessage(bytes, fields, messages, enums);
    }
  }
}

export function decodeMessage(
  bytes: Uint8Array,
  descriptors: readonly GrpcFieldDescriptor[],
  messages: GrpcMessageRegistry,
  enums: GrpcEnumRegistry,
): Record<string, unknown> {
  const byNumber = new Map(descriptors.map((field) => [field.number, field] as const));
  const result: Record<string, unknown> = {};
  for (const field of descriptors) {
    if (field.repeated) {
      result[field.property] = [];
    } else if (field.defaultsWhenAbsent) {
      result[field.property] = zeroValue(field.kind);
    }
  }
  for (const raw of iterateFields(bytes)) {
    const field = byNumber.get(raw.fieldNumber);
    if (!field) {
      continue; // Unknown field (forward-compat schema drift) — skip.
    }
    const valueBytes =
      raw.wireType === WIRE_LENGTH_DELIMITED
        ? bytes.subarray(raw.offset, raw.next)
        : bytes.subarray(raw.offset, raw.next);
    const decoded = decodeScalar(field.kind, valueBytes, field.refName, messages, enums);
    if (field.repeated) {
      (result[field.property] as unknown[]).push(decoded);
    } else {
      result[field.property] = decoded;
    }
  }
  return result;
}

// ---------------------------------------------------------------------
// gRPC-Web framing: 5-byte header (compression flag + big-endian u32
// length) per frame; a response body is zero-or-one data frames followed
// by exactly one trailer frame (flagged via bit 0x80 on the header byte).
// ---------------------------------------------------------------------

function frameMessage(bytes: Uint8Array): Uint8Array {
  const header = new Uint8Array(5);
  new DataView(header.buffer).setUint32(1, bytes.length, false);
  return concatBytes([header, bytes]);
}

interface ParsedGrpcWebResponse {
  message: Uint8Array | undefined;
  status: number;
  statusMessage: string;
}

function parseGrpcWebBody(body: Uint8Array): ParsedGrpcWebResponse {
  let pos = 0;
  let message: Uint8Array | undefined;
  let status = 0;
  let statusMessage = "";
  let sawTrailer = false;

  while (pos < body.length) {
    if (pos + 5 > body.length) {
      throw new CratestackGrpcTransportError("truncated gRPC-Web frame header");
    }
    const flags = byteAt(body, pos);
    const length = new DataView(body.buffer, body.byteOffset + pos + 1, 4).getUint32(0, false);
    const payloadStart = pos + 5;
    const payloadEnd = payloadStart + length;
    if (payloadEnd > body.length) {
      throw new CratestackGrpcTransportError("truncated gRPC-Web frame body");
    }
    const payload = body.subarray(payloadStart, payloadEnd);

    if ((flags & 0x80) !== 0) {
      sawTrailer = true;
      const text = new TextDecoder().decode(payload);
      for (const line of text.split("\r\n")) {
        const separator = line.indexOf(":");
        if (separator === -1) continue;
        const key = line.slice(0, separator).trim().toLowerCase();
        const value = line.slice(separator + 1).trim();
        if (key === "grpc-status") {
          status = Number.parseInt(value, 10);
        } else if (key === "grpc-message") {
          statusMessage = decodeURIComponent(value);
        }
      }
    } else {
      message = payload;
    }

    pos = payloadEnd;
  }

  if (!sawTrailer) {
    throw new CratestackGrpcTransportError("gRPC-Web response body has no trailer frame");
  }
  return { message, status, statusMessage };
}

// ---------------------------------------------------------------------
// Errors — mirrors `CratestackRpcError`/`CratestackRpcTransportError`'s
// shape (`rpc-runtime.ts.j2`) for consistency across the three generated
// transports: a typed error for a real server-emitted status, a separate
// one for anything that never got that far.
// ---------------------------------------------------------------------

/** Same open string union `rpc-runtime.ts.j2` uses, reached from the
 *  numeric `grpc-status` via the inverse of `cratestack-grpc::error::
 *  rpc_code_to_tonic_code` — every code that table produces round-trips
 *  back to its original string; an unrecognized number falls back to its
 *  decimal string form rather than losing information. */
export type GrpcErrorCode =
  | "canceled"
  | "unknown"
  | "invalid_argument"
  | "deadline_exceeded"
  | "not_found"
  | "conflict"
  | "permission_denied"
  | "failed_precondition"
  | "unimplemented"
  | "internal"
  | "unavailable"
  | "unauthenticated"
  | string;

const GRPC_STATUS_TO_CODE: Record<number, GrpcErrorCode> = {
  1: "canceled",
  2: "unknown",
  3: "invalid_argument",
  4: "deadline_exceeded",
  5: "not_found",
  6: "conflict",
  7: "permission_denied",
  9: "failed_precondition",
  12: "unimplemented",
  13: "internal",
  14: "unavailable",
  16: "unauthenticated",
};

export function grpcStatusToErrorCode(status: number): GrpcErrorCode {
  return GRPC_STATUS_TO_CODE[status] ?? String(status);
}

export class CratestackGrpcError extends Error {
  readonly status: number;
  readonly code: GrpcErrorCode;

  constructor(status: number, message: string) {
    super(`gRPC call failed with code ${grpcStatusToErrorCode(status)} (status ${status}): ${message}`);
    this.name = "CratestackGrpcError";
    this.status = status;
    this.code = grpcStatusToErrorCode(status);
  }
}

export class CratestackGrpcTransportError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "CratestackGrpcTransportError";
  }
}

// ---------------------------------------------------------------------
// The runtime itself.
// ---------------------------------------------------------------------

export interface CratestackGrpcClientOptions {
  fetch?: typeof fetch;
  headers?: HeadersInit | (() => HeadersInit | Promise<HeadersInit>);
}

export interface CratestackGrpcCallOptions {
  headers?: HeadersInit;
  signal?: AbortSignal;
}

export class CratestackGrpcWebRuntime {
  readonly origin: string;
  readonly fetchFn: typeof fetch;
  readonly defaultHeaders: HeadersInit | (() => HeadersInit | Promise<HeadersInit>) | undefined;

  constructor(origin: string, options: CratestackGrpcClientOptions = {}) {
    this.origin = origin.replace(/\/+$/, "");
    this.fetchFn = options.fetch ?? fetch;
    this.defaultHeaders = options.headers;
  }

  /** Unary gRPC-Web call: encodes `request` against `requestFields`,
   *  frames + POSTs it as `application/grpc-web+proto`, and decodes the
   *  single response message frame against `responseFields`. A non-zero
   *  `grpc-status` (from the trailer frame, or a non-2xx HTTP status)
   *  raises {@link CratestackGrpcError}. */
  async unary<TReq extends Record<string, unknown>, TRes>(
    path: string,
    request: TReq,
    requestFields: readonly GrpcFieldDescriptor[],
    responseFields: readonly GrpcFieldDescriptor[],
    messages: GrpcMessageRegistry,
    enums: GrpcEnumRegistry,
    options: CratestackGrpcCallOptions = {},
  ): Promise<TRes> {
    const headers = await this.buildHeaders(options.headers);
    headers.set("Content-Type", "application/grpc-web+proto");
    headers.set("Accept", "application/grpc-web+proto");
    headers.set("X-Grpc-Web", "1");

    const body = frameMessage(encodeMessage(request, requestFields, messages, enums));
    const response = await this.fetchFn(this.url(path), {
      method: "POST",
      headers,
      // `Uint8Array<ArrayBufferLike>`'s generic form isn't structurally
      // identical to the DOM lib's `BufferSource` in every TS/lib
      // combination — a real `ArrayBufferView`, which is all `fetch`
      // needs at runtime, so this is a type-system-only cast.
      body: body as BodyInit,
      signal: options.signal ?? null,
    });

    if (!response.ok) {
      throw new CratestackGrpcTransportError(
        `gRPC-Web call to ${path} failed with HTTP status ${response.status}`,
      );
    }

    const bodyBytes = new Uint8Array(await response.arrayBuffer());

    // "Trailers-Only" response: a unary call that fails (or succeeds with
    // nothing to send) before ever writing a message frame carries
    // `grpc-status`/`grpc-message` directly as HTTP response headers with
    // an empty body, rather than as a gRPC-Web trailer frame — real,
    // observed tonic-web behavior (verified against the running
    // `grpc-widgets-example` server), not a spec footnote:
    // `parseGrpcWebBody` would otherwise reject the empty body as "no
    // trailer frame".
    const headerStatus = response.headers.get("grpc-status");
    if (headerStatus !== null && bodyBytes.length === 0) {
      const status = Number.parseInt(headerStatus, 10);
      if (status !== 0) {
        const message = response.headers.get("grpc-message");
        throw new CratestackGrpcError(status, message ? decodeURIComponent(message) : "");
      }
      return undefined as TRes;
    }

    const parsed = parseGrpcWebBody(bodyBytes);
    if (parsed.status !== 0) {
      throw new CratestackGrpcError(parsed.status, parsed.statusMessage);
    }
    if (!parsed.message) {
      return undefined as TRes;
    }
    return decodeMessage(parsed.message, responseFields, messages, enums) as TRes;
  }

  private async buildHeaders(extra?: HeadersInit): Promise<Headers> {
    const headers = new Headers(await resolveHeaders(this.defaultHeaders));
    for (const [key, value] of new Headers(extra)) {
      headers.set(key, value);
    }
    return headers;
  }

  private url(path: string): string {
    const normalizedPath = path.startsWith("/") ? path : `/${path}`;
    return new URL(normalizedPath, `${this.origin}/`).toString();
  }
}

async function resolveHeaders(
  headers: HeadersInit | (() => HeadersInit | Promise<HeadersInit>) | undefined,
): Promise<HeadersInit | undefined> {
  if (typeof headers === "function") {
    return headers();
  }
  return headers;
}
