import {
  CratestackRpcRuntime,
  type CratestackRpcCallOptions,
  type CratestackRpcClientOptions,
} from "./runtime.js";
import { toRpcListInput, type CratestackRpcListQuery } from "./queries.js";
import { reviveDecimalFields, revivePagedDecimalFields, reviveDecimalScalar } from "./models.js";
import type {
{% for interface in interfaces %}
  {{ interface.name }},
{% endfor %}
{% for enum in enums %}
  {{ enum.name }},
{% endfor %}
  Page,
} from "./models.js";

export class {{ client_class_name }} {
  readonly runtime: CratestackRpcRuntime;
  readonly procedures: ProceduresApi;
{% for model in models %}
  readonly {{ model.accessor }}: {{ model.api_name }};
{% endfor %}

  constructor(originOrRuntime: string | CratestackRpcRuntime, options: CratestackRpcClientOptions = {}) {
    this.runtime = typeof originOrRuntime === "string"
      ? new CratestackRpcRuntime(originOrRuntime, options)
      : originOrRuntime;
    this.procedures = new ProceduresApi(this.runtime);
{% for model in models %}
    this.{{ model.accessor }} = new {{ model.api_name }}(this.runtime);
{% endfor %}
  }
}

{% for model in models %}
{% if model.computed_params_interface %}
/** Extends {@link CratestackRpcCallOptions} with the typed `computedParams`
 *  option for `{{ model.api_name }}.get` (`docs/design/computed-fields.md`)
 *  — {{ model.name }} declares at least one parameterized
 *  `@computed(params: <Type>?)` field, so (unlike a model with none) it
 *  gets this option, rather than the bare `CratestackRpcCallOptions`. */
export interface {{ model.api_name }}GetOptions extends CratestackRpcCallOptions {
  computedParams?: {{ model.computed_params_interface }};
}

{% endif %}
export class {{ model.api_name }} {
  constructor(private readonly runtime: CratestackRpcRuntime) {}

  list(query: CratestackRpcListQuery{% if model.computed_params_interface %}<{{ model.computed_params_interface }}>{% endif %} = {}, options: CratestackRpcCallOptions = {}): Promise<{{ model.list_return_type }}> {
    return this.runtime.call<Record<string, unknown>, unknown>(
      "model.{{ model.name }}.list",
      toRpcListInput(query),
      options,
    ).then((value) => {% if model.is_paged %}revivePagedDecimalFields{% else %}reviveDecimalFields{% endif %}(value, '{{ model.decimal_shape_name }}') as {{ model.list_return_type }});
  }

{% if model.computed_params_interface %}
  get(id: {{ model.primary_key_type }}, options: {{ model.api_name }}GetOptions = {}): Promise<{{ model.name }}> {
    return this.runtime.call<Record<string, unknown>, unknown>(
      "model.{{ model.name }}.get",
      options.computedParams && Object.keys(options.computedParams as Record<string, unknown>).length > 0
        ? { id, computedParams: JSON.stringify(options.computedParams) }
        : { id },
      options,
    ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }
{% else %}
  get(id: {{ model.primary_key_type }}, options: CratestackRpcCallOptions = {}): Promise<{{ model.name }}> {
    return this.runtime.call<{ id: {{ model.primary_key_type }} }, unknown>(
      "model.{{ model.name }}.get",
      { id },
      options,
    ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }
{% endif %}

{% if model.allows_create %}
  create(input: {{ model.create_input_name }}, options: CratestackRpcCallOptions = {}): Promise<{{ model.name }}> {
    return this.runtime.call<{{ model.create_input_name }}, unknown>(
      "model.{{ model.name }}.create",
      input,
      options,
    ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }

{% endif %}
  update(
    id: {{ model.primary_key_type }},
    patch: {{ model.update_input_name }},
    options: CratestackRpcCallOptions = {},
  ): Promise<{{ model.name }}> {
    return this.runtime.call<{ id: {{ model.primary_key_type }}; patch: {{ model.update_input_name }} }, unknown>(
      "model.{{ model.name }}.update",
      { id, patch },
      options,
    ).then((value) => reviveDecimalFields(value, '{{ model.decimal_shape_name }}') as {{ model.name }});
  }

  delete(id: {{ model.primary_key_type }}, options: CratestackRpcCallOptions = {}): Promise<void> {
    return this.runtime.call<{ id: {{ model.primary_key_type }} }, void>(
      "model.{{ model.name }}.delete",
      { id },
      options,
    );
  }
}

{% endfor %}
export class ProceduresApi {
  constructor(private readonly runtime: CratestackRpcRuntime) {}

{% for procedure in procedures %}
{% if procedure.decimal_revival_kind == "scalar" %}
  {{ procedure.method_name }}(args: {{ procedure.args_name }}, options: CratestackRpcCallOptions = {}): Promise<{{ procedure.return_type }}> {
    return this.runtime.call<{{ procedure.args_name }}, unknown>(
      "procedure.{{ procedure.name }}",
      args,
      options,
    ).then((value) => reviveDecimalScalar(value) as {{ procedure.return_type }});
  }
{% else %}
  {{ procedure.method_name }}(args: {{ procedure.args_name }}, options: CratestackRpcCallOptions = {}): Promise<{{ procedure.return_type }}> {
    return this.runtime.call<{{ procedure.args_name }}, unknown>(
      "procedure.{{ procedure.name }}",
      args,
      options,
    ).then((value) => {% if procedure.decimal_paged %}revivePagedDecimalFields{% else %}reviveDecimalFields{% endif %}(value, '{{ procedure.decimal_shape_name }}') as {{ procedure.return_type }});
  }
{% endif %}

{% endfor %}
}
