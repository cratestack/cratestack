// Exercises the typed `computedParams` surface (docs/design/computed-fields.md's
// "Downstream" section): `Image` declares a parameterized `@computed(params: ProxyParams?)`
// field, so it's gated — `get`/`list` accept a typed `computedParams` option.
// `Widget` declares none, so it stays ungated (the `never` default) — one
// schema covers both branches of the per-model type-system gate in a single
// generated package.

model Image {
  id Int @id
  storageKey String
  proxyUrl String @computed(params: ProxyParams?)

  @@allow("create", true)
}

type ProxyParams {
  width Int?
  height Int?
}

model Widget {
  id Int @id
  name String

  @@allow("create", true)
}
