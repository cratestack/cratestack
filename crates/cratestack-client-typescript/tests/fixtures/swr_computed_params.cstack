// `--swr` repro for cratestack#1154: `Image` declares a parameterized
// `@computed` field, so its generated `ImageComputedParams` interface is
// referenced by the `list`/`get` hooks in `image.hooks.ts`, which must import it.
// `Widget` declares no computed fields, so its hooks file must not import
// any `*ComputedParams` type.

model Image {
  id Int @id
  storageKey String
  proxyUrl String @computed(params: ProxyParams?)

  @@allow("create", true)
}

type ProxyParams {
  width Int?
  height Int?
}

model Widget {
  id Int @id
  name String

  @@allow("create", true)
}

// List-only: `@@internal("detail")` hides `get`, so its hooks file has a
// `list` hook that uses `ListingComputedParams` and no `get` hook.
model Listing {
  id Int @id
  title String
  thumbUrl String @computed(params: ProxyParams?)

  @@allow("read", true)
  @@internal("detail")
}

// Get-only: `@@internal("list")` hides `list`, so its hooks file has a
// `get` hook only, which under REST uses `ReceiptComputedParams`.
model Receipt {
  id Int @id
  label String
  previewUrl String @computed(params: ProxyParams?)

  @@allow("read", true)
  @@internal("list")
}
