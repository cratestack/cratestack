// Slice S6 fixture: a generated TypeScript client's subscriptions
// (`tests/subscriptions_runtime.rs`): a model feed and a subscription
// procedure, over SSE, a WebSocket, and `"auto"`'s fallback.

transport rpc

model Note {
  id Int @id
  body String
  amount Decimal

  @@allow("read", true)
  @@emit(created)
  @@subscribe
}

// Uuid id and Decimal: a cbor-seq feed's `event_id` and `id` are byte strings
// (`tests/js/subscriptions/cbor-seq.test.ts`, cratestack#1001).
model SeqNote {
  id Uuid @id
  amount Decimal
  body String

  @@allow("read", true)
  @@emit(created)
  @@subscribe
}

type Room {
  roomId String
}

type Line {
  body String
}

subscription procedure lines(args: Room): Line
