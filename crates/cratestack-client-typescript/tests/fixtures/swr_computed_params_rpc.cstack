// RPC counterpart of swr_computed_params.cstack (cratestack#1154).

transport rpc

model Image {
  id Int @id
  storageKey String
  proxyUrl String @computed(params: ProxyParams?)

  @@allow("create", true)
}

type ProxyParams {
  width Int?
  height Int?
}

model Widget {
  id Int @id
  name String

  @@allow("create", true)
}
