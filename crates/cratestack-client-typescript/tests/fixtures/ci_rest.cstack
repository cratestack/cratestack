// Richer REST fixture for the TypeScript CI-verification harness (issue #419).
// Same shape as the Dart ci_rest.cstack: multiple models, a relation, an enum
// (as a field, an array field, and a procedure return type), and both a query
// and a mutation procedure — to exercise the full template surface that needs
// to typecheck.

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth SessionUser {
  id Int
}

enum PostStatus {
  draft
  published
  archived
}

type PostStatusFilter {
  statuses PostStatus[]
}

model Author {
  id Int @id
  name String
  posts Post[] @relation(fields:[id],references:[authorId])
}

model Post {
  id Int @id
  title String
  status PostStatus
  published Boolean
  authorId Int
  author Author @relation(fields:[authorId],references:[id])

  @@allow("read", published || authorId == auth().id)
  @@allow("create", auth() != null)
  @@paged
}

// `searchPosts`, not `listPosts` — DELIBERATE (cratestack#777). Under
// `--swr`, model `Post` exports a free function `listPosts` and the
// barrel `src/swr/index.ts` `export *`s both it and `./procedures.js`, so
// a procedure named `listPosts` is a TS2308 in the generated package. The
// generator now refuses that schema outright
// (`TypeScriptGeneratorError::SwrProcedureNameCollision`), which means
// renaming this back would fail generation, not just `tsc`.
procedure searchPosts(filter: PostStatusFilter?): Post[]
  @allow(auth() != null)

mutation procedure currentStatus(postId: Int): PostStatus
  @allow(auth() != null)
