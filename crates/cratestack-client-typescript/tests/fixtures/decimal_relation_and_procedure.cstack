// Dedicated fixture for cratestack#499's remediation of #498's F2 (a
// procedure's own return type must revive `Decimal` fields, including a
// bare scalar `Decimal` return) and F5 (a relation-embedded `Decimal`
// field must revive too) — deliberately separate from
// `decimal_scalar.cstack`, whose `Invoice` shape several existing tests
// (`tests/generator.rs`) assert an exact `reviveWireFields(value, [...])`
// key list against; adding a relation there would perturb that list.

model Customer {
  id Cuid @id @default(cs_cuid())
  balance Decimal

  @@allow("list", true)
}

model Invoice {
  id Cuid @id @default(cs_cuid())
  amountXaf Decimal
  customerId Cuid
  customer Customer @relation(fields:[customerId],references:[id])

  @@allow("list", true)
}

type QuoteResult {
  price Decimal
}

procedure quote(reference: String): QuoteResult
procedure quickQuote(reference: String): Decimal
